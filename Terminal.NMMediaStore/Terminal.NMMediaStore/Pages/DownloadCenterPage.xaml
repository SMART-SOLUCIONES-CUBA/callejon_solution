<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mg="clr-namespace:MagicGradients;assembly=MagicGradients"
    xmlns:ic="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Converters"
    xmlns:views="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Views"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Pages.DownloadCenterPage"
    x:Name="Page"
    Style="{StaticResource BasePageStyle}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrentStorageUsedBoxWidthConverter x:Key="CurrentStorageUsedBoxWidthConverter" Page="{x:Reference Page}" />
            <converters:VirtualStorageUsedBoxWidthConverter x:Key="VirtualStorageUsedBoxWidthConverter" Page="{x:Reference Page}" />
            <converters:AudioVisualToPlacardContentViewConverter x:Key="AudioVisualToPlacardContentViewConverter" DownsampleHeight="180" />
            <converters:AudioVisualEnumerationToStorageSpaceConverter x:Key="AudioVisualEnumerationToStorageSpaceConverter" />
            <converters:MasterPageModelToVirtualStorageUsedSpaceConverter x:Key="MasterPageModelToVirtualStorageUsedSpaceConverter" />
            <converters:CollectionToJoinedStringBindingConverter x:Key="CollectionToJoinedStringBindingConverter" />
            <converters:TimeSpanToFullStringConverter x:Key="TimeSpanToFullStringConverter" />

            <sscxftoolkitpresentationconverters:FileSizeLongToStringConverter x:Key="FileSizeLongToStringConverter" />
            <sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:EnumerationToCountConverter x:Key="EnumerationToCountConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />

            <x:Double x:Key="TargetStorageSpaceBoxViewHeight">12</x:Double>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <mg:GradientView Grid.RowSpan="3">
                <mg:GradientView.GradientSource>
                    <mg:CssGradientSource>
                        <x:String>
                            <![CDATA[
                                radial-gradient(circle at left bottom, #555555 0%,#555555 6%,#535353 6%,#535353 15%,#525252 15%,#525252 47%,#515151 47%,#515151 54%,#4f4f4f 54%,#4f4f4f 56%,#4d4d4d 56%,#4d4d4d 90%,#4c4c4c 90%,#4c4c4c 100%)
                            ]]>
                        </x:String>
                    </mg:CssGradientSource>
                </mg:GradientView.GradientSource>
            </mg:GradientView>
            <StackLayout
                Grid.Row="0"
                BackgroundColor="#CC000000"
                Padding="0,0,0,8"
                Spacing="2">
                <Label
                    HorizontalOptions="Center"
                    LineBreakMode="TailTruncation">
                    <Label.FontFamily>
                        <OnPlatform x:TypeArguments="x:String" Default="Myriad Pro Regular">
                            <On Platform="UWP" Value="/Assets/Fonts/MYRIADPRO-REGULAR.OTF#Myriad Pro" />
                        </OnPlatform>
                    </Label.FontFamily>
                    <Label.FontSize>
                        <OnPlatform x:TypeArguments="x:Double" Default="36"></OnPlatform>
                    </Label.FontSize>
                    <Label.FormattedText>
                        <FormattedString>
                            <FormattedString.Spans>
                                <Span Text="Mediateca " TextColor="{StaticResource PrimaryTextColor}" />
                                <Span Text="Nuevo Mundo" TextColor="{StaticResource SecoundaryTextColor}" />
                            </FormattedString.Spans>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </StackLayout>
            <Label
                Grid.Row="1"
                HorizontalTextAlignment="Center"
                Padding="0,3,0,4"
                BackgroundColor="{StaticResource DarkBackgroundColor}"
                Text="Centro de Descargas"
                TextColor="{StaticResource PrimaryAccentColor}"
                FontSize="{StaticResource Header3FontSize}">
                <Label.FontFamily>
                    <OnPlatform x:TypeArguments="x:String" Default="Myriad Pro Italic">
                        <On Platform="UWP" Value="/Assets/Fonts/MYRIADPRO-IT.OTF#Myriad Pro" />
                    </OnPlatform>
                </Label.FontFamily>
            </Label>
            <Grid 
                Grid.Row="2"                
                Padding="12,12,12,0"
                ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackLayout
                    Grid.ColumnSpan="2" Grid.Row="0">
                    <Label
                        Text="Cliente"
                        TextColor="{StaticResource SecoundaryTextColor}" />
                    <Grid 
                        Margin="16"
                        ColumnSpacing="12"
                        RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ic:CircleImage
                            Grid.Column="0" Grid.RowSpan="3"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            Margin="0,8"
                            BorderThickness="2"
                            BorderColor="Snow"
                            WidthRequest="{StaticResource MiddleAvatarSize}"
                            HeightRequest="{StaticResource MiddleAvatarSize}" 
                            Source="{Binding Path=MasterBindingContext.Subscriptor.ImageSource}">
                        </ic:CircleImage>
                        <Label
                            Grid.Column="1" Grid.Row="0"
                            VerticalOptions="End"
                            Text="{Binding Path=MasterBindingContext.Subscriptor.Name}"
                            FontSize="{StaticResource Header1FontSize}">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Myriad Pro Condensed Italic">
                                    <On Platform="UWP" Value="/Assets/Fonts/MYRIADPRO-CONDIT.OTF#Myriad Pro" />
                                </OnPlatform>
                            </Label.FontFamily>
                        </Label>
                        <Label
                            Grid.Column="1" Grid.Row="1"
                            VerticalOptions="Start"
                            Text="{Binding Path=MasterBindingContext.Subscriptor.LastName}"
                            FontSize="{StaticResource Header2FontSize}">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Myriad Pro Condensed Italic">
                                    <On Platform="UWP" Value="/Assets/Fonts/MYRIADPRO-CONDIT.OTF#Myriad Pro" />
                                </OnPlatform>
                            </Label.FontFamily>
                        </Label>
                    </Grid>
                </StackLayout>
                <StackLayout
                    Grid.ColumnSpan="2" Grid.Row="1">
                    <Label
                        Text="Resumen"
                        TextColor="{StaticResource SecoundaryTextColor}" />
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Column="0" Grid.Row="0"
                            Text="Cantidad de Audio Visuales a descargar"/>
                        <Label
                            x:Name="FetchOrderAudioVisualSummaryCountLabel"
                            Grid.Column="0" Grid.Row="0"
                            HorizontalTextAlignment="End"
                            Text="{Binding Path=MasterBindingContext.FetchOrderAudioVisuals, Converter={StaticResource EnumerationToCountConverter}}"
                            TextColor="{StaticResource SecoundaryAccentColor}" />
                        <Label
                            Grid.Column="0" Grid.Row="1"
                            Text="Espacio de almacenamiento necesario"/>
                        <Label
                            Grid.Column="0" Grid.Row="1"
                            HorizontalTextAlignment="End"
                            Text="{Binding Path=MasterBindingContext.FetchOrderAudioVisuals, Converter={StaticResource AudioVisualEnumerationToStorageSpaceConverter}}"
                            TextColor="{StaticResource SecoundaryAccentColor}" />
                    </Grid>
                </StackLayout>
                <StackLayout Grid.ColumnSpan="2" Grid.Row="2">
                    <Label
                        Text="Destino"
                        TextColor="{StaticResource SecoundaryTextColor}" />
                    <Grid 
                        Margin="16,16,32,0"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Column="0" Grid.RowSpan="3"
                            VerticalOptions="Center"
                            Margin="4,0"
                            Text="AHORA"
                            TextColor="{StaticResource SecoundaryTextColor}"
                            Rotation="-90" />
                        <Label
                            Grid.Column="1" Grid.RowSpan="3"
                            VerticalOptions="Center"
                            Text="{Binding Path=MasterBindingContext.Target.FamilyRepresentativeIconGlyph}"
                            TextColor="White"
                            FontSize="{StaticResource LargeIconSize}">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                                    <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                                </OnPlatform>
                            </Label.FontFamily>
                        </Label>
                        <Label
                            Grid.Column="2" Grid.Row="0"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Path=MasterBindingContext.Target.Storage.Caption}"
                            TextColor="White"
                            FontSize="{StaticResource Header3FontSize}">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Myriad Pro Condensed">
                                    <On Platform="UWP" Value="/Assets/Fonts/MYRIADPRO-COND.OTF#Myriad Pro" />
                                </OnPlatform>
                            </Label.FontFamily>
                        </Label>
                        <BoxView
                            x:Name="TargetStorageCurrentTotalSpaceBoxView"
                            Grid.Column="2" Grid.Row="1"
                            BackgroundColor="White"
                            HeightRequest="{StaticResource TargetStorageSpaceBoxViewHeight}" />
                        <BoxView
                            Grid.Column="2" Grid.Row="1"
                            BackgroundColor="{StaticResource SecoundaryDarkActionColor}"
                            HeightRequest="{StaticResource TargetStorageSpaceBoxViewHeight}"
                            WidthRequest="{Binding Source={x:Reference TargetStorageCurrentTotalSpaceBoxView}, Path=Width, Converter={StaticResource CurrentStorageUsedBoxWidthConverter}}"
                            HorizontalOptions="Start" />
                        <Label
                            Grid.Column="2" Grid.Row="2"
                            Margin="0,0,0,10">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Path=MasterBindingContext.Target.Storage.UsedSpace, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                    <Span Text="  usados de  " TextColor="{StaticResource SecoundaryTextColor}" />
                                    <Span Text="{Binding Path=MasterBindingContext.Target.Storage.TotalSpace, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                    <BoxView 
                        Margin="14,4"
                        Color="{StaticResource AlternativeBackgroundColor}"
                        HeightRequest="1" />
                    <Grid 
                        Margin="16,0,32,16"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            VerticalOptions="Center"
                            Grid.Column="0" Grid.RowSpan="3"
                            Text="DESPUES"
                            TextColor="{StaticResource SecoundaryTextColor}"
                            Rotation="-90" />
                        <Label
                            Grid.Column="1" Grid.RowSpan="3"
                            VerticalOptions="Center"
                            Text="{Binding Path=MasterBindingContext.Target.FamilyRepresentativeIconGlyph}"
                            TextColor="White"
                            FontSize="{StaticResource LargeIconSize}">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                                    <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                                </OnPlatform>
                            </Label.FontFamily>
                        </Label>
                        <Label
                            Grid.Column="2" Grid.Row="0"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Path=MasterBindingContext.Target.Storage.Caption}"
                            TextColor="White"
                            FontSize="{StaticResource Header3FontSize}">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Myriad Pro Condensed">
                                    <On Platform="UWP" Value="/Assets/Fonts/MYRIADPRO-COND.OTF#Myriad Pro" />
                                </OnPlatform>
                            </Label.FontFamily>
                        </Label>
                        <views:StorageSpaceReferenceBoxView
                            x:Name="TargetStorageVirtualTotalSpaceBoxView"
                            Grid.Column="2" Grid.Row="1"
                            BackgroundColor="White"
                            HeightRequest="{StaticResource TargetStorageSpaceBoxViewHeight}" />
                        <BoxView
                            Grid.Column="2" Grid.Row="1"
                            BackgroundColor="{StaticResource PrimaryDarkActionColor}"
                            HeightRequest="{StaticResource TargetStorageSpaceBoxViewHeight}"
                            WidthRequest="{Binding Source={x:Reference TargetStorageVirtualTotalSpaceBoxView}, Path=Width, Converter={StaticResource VirtualStorageUsedBoxWidthConverter}}"
                            HorizontalOptions="Start" />
                        <Label
                            Grid.Column="2" Grid.Row="2"
                            Margin="0,0,0,10">
                            <Label.FormattedText>
                                <FormattedString>
                                    <views:VirtualStorageSpaceUseSpan Text="{Binding Path=MasterBindingContext, Converter={StaticResource MasterPageModelToVirtualStorageUsedSpaceConverter}}" x:Name="VirtualStoreUsedSpaceSpan" />
                                    <Span Text="  usados de  " TextColor="{StaticResource SecoundaryTextColor}" />
                                    <Span Text="{Binding Path=MasterBindingContext.Target.Storage.TotalSpace, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </StackLayout>
                <Button
                    Grid.Row="4" Grid.Column="0"
                    Margin="0,0,0,12"
                    IsEnabled="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                    BackgroundColor="{StaticResource SecoundaryDarkActionColor}"
                    ContentLayout="Left,10"
                    Text="Agregar Más"
                    Clicked="BackButton_Clicked">
                    <Button.ImageSource>
                        <FontImageSource
                            Glyph="&#xf13d;">
                            <FontImageSource.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                                    <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                                </OnPlatform>
                            </FontImageSource.FontFamily>
                        </FontImageSource>
                    </Button.ImageSource>
                </Button>
                <Button
                    Grid.Row="4" Grid.Column="1"
                    Margin="0,0,0,12"
                    IsEnabled="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                    BackgroundColor="{StaticResource PrimaryActionColor}"
                    ContentLayout="Left,10"
                    Text="Completar"
                    TextColor="Black"
                    Clicked="FetchOrderCompleteButton_Clicked">
                    <Button.ImageSource>
                        <FontImageSource
                            Color="Black"
                            Glyph="&#xf790;">
                            <FontImageSource.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                                    <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                                </OnPlatform>
                            </FontImageSource.FontFamily>
                        </FontImageSource>
                    </Button.ImageSource>
                </Button>
                <StackLayout 
                    Grid.Column="2" Grid.RowSpan="5"
                    Spacing="0">
                    <Label
                        Text="Listado de Descargas"
                        TextColor="{StaticResource SecoundaryTextColor}" />
                    <BoxView 
                        Margin="0,6,0,0"
                        Color="{StaticResource AlternativeBackgroundColor}"
                        HeightRequest="1" />
                    <ScrollView VerticalOptions="FillAndExpand">
                        <StackLayout
                            Margin="0,6,0,6"
                            Spacing="0"
                            BindableLayout.ItemsSource="{Binding Path=MasterBindingContext.FetchOrderAudioVisuals}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Text="No se han agregado elementos"
                                    TextColor="DimGray" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ContentView
                                            Grid.Column="0" Grid.RowSpan="4"
                                            WidthRequest="320" HeightRequest="180"
                                            Content="{Binding Converter={StaticResource AudioVisualToPlacardContentViewConverter}}" />
                                        <Label 
                                            Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding Path=Title}"
                                            FontSize="{StaticResource Header4FontSize}" />
                                        <Label 
                                            Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Path=Genres, Converter={StaticResource CollectionToJoinedStringBindingConverter}}"
                                            TextColor="{StaticResource SecoundaryAccentColor}"
                                            FontSize="{StaticResource Header5FontSize}">
                                            <Label.FontFamily>
                                                <OnPlatform x:TypeArguments="x:String" Default="Myriad Pro Condensed Italic">
                                                    <On Platform="UWP" Value="/Assets/Fonts/MYRIADPRO-CONDIT.OTF#Myriad Pro" />
                                                </OnPlatform>
                                            </Label.FontFamily>
                                        </Label>
                                        <Label 
                                            Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3"
                                            Text="{Binding Path=About}"
                                            TextColor="{StaticResource SecoundaryTextColor}" />
                                        <Button
                                            Grid.RowSpan="2" Grid.Column="5"
                                            VerticalOptions="Start"
                                            Padding="4"
                                            BackgroundColor="Transparent"
                                            Text="&#xfd45;"
                                            TextColor="Red"
                                            FontSize="{StaticResource SmallIconSize}"
                                            Clicked="FetchOrderAudioVisualItemRemoveButton_Clicked">
                                            <Button.FontFamily>
                                                <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                                                    <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                                                </OnPlatform>
                                            </Button.FontFamily>
                                        </Button>
                                        <Label 
                                            Grid.Row="3" Grid.Column="1"
                                            Margin="0,0,0,6"
                                            BackgroundColor="White"
                                            Padding="6,4"
                                            Text="{Binding Path=Quality}"
                                            TextColor="{StaticResource DarkBackgroundColor}" />
                                        <Label 
                                            Grid.Row="3" Grid.Column="2"
                                            Margin="0,0,0,6"
                                            BackgroundColor="White"
                                            Padding="6,4"
                                            Text="{Binding Path=FileSize, Converter={StaticResource FileSizeLongToStringConverter}}"
                                            TextColor="{StaticResource DarkBackgroundColor}" />
                                        <Label 
                                            Grid.Row="3" Grid.Column="3"
                                            IsVisible="{Binding Path=HasSubtitle}"
                                            Margin="0,0,0,6"
                                            BackgroundColor="White"
                                            Padding="6,4,7,4"
                                            Text="+SUB"
                                            TextColor="{StaticResource DarkBackgroundColor}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </ScrollView>
                </StackLayout>
            </Grid>
            <Grid
                Grid.Row="2"
                IsVisible="{Binding Path=IsBusy}"
                BackgroundColor="#EF000000">
                <StackLayout 
                    VerticalOptions="Center" HorizontalOptions="Center"
                    WidthRequest="280">
                    <ActivityIndicator 
                        VerticalOptions="Center" HorizontalOptions="Center"
                        HeightRequest="64" WidthRequest="64"
                        IsRunning="True" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="{Binding Path=BusyProgressMessage}"
                        FontSize="{StaticResource Header3FontSize}" />
                    <StackLayout
                        Margin="0,10,0,0"
                        IsVisible="{Binding Path=DownloadingIndex}">
                        <Label
                            TextColor="{StaticResource SecoundaryTextColor}"
                            FontSize="{StaticResource MiddleTextFontSize}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Audio Visual " />
                                    <Span Text="{Binding Path=DownloadingIndex}" />
                                    <Span Text=" de " />
                                    <Span Text="{Binding Path=MasterBindingContext.FetchOrderAudioVisuals, Converter={StaticResource EnumerationToCountConverter}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <ProgressBar Progress="{Binding Path=ProgressPercent}" />
                        <Label
                            TextColor="{StaticResource SecoundaryTextColor}"
                            HorizontalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Path=TransferProgress, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                    <Span Text=" de " />
                                    <Span Text="{Binding Path=TransferLength, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label
                            Margin="0,6,0,0"
                            TextColor="{StaticResource SecoundaryTextColor}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Tiempo transcurrido: " />
                                    <Span Text="{Binding Path=Time, Converter={StaticResource TimeSpanToFullStringConverter}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>