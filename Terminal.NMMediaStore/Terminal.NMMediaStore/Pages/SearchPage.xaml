<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mg="clr-namespace:MagicGradients;assembly=MagicGradients"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Converters"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Pages.SearchPage"
    NavigationPage.HasNavigationBar="False"
    Style="{StaticResource BasePageStyle}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />

            <converters:InvalidYearToReplacementStringConverter x:Key="InvalidYearToReplacementStringConverter" InvalidStringReplacement="-" />
            <converters:NullToReplacementStringConverter x:Key="NullToReplacementStringConverter" NullStringReplacement="-" />
            <converters:FlextLayoutToResponsiveItemWidthConverter x:Key="FlextLayoutToResponsiveItemWidthConverter" ItemMinWidth="240" ItemHorizontalMargin="16" />
            <converters:CollectionToJoinedStringBindingConverter x:Key="EmptyCollectionToJoinedStringBindingConverter" />
            <converters:CollectionToJoinedStringBindingConverter x:Key="NoEmptyCollectionToJoinedStringBindingConverter" EmptyStringReplacement="-" />
            <converters:CategoryModelToTreeNameConverter x:Key="CategoryModelToTreeNameConverter" />

            <Style x:Key="SearchItemFieldCaptionLabel" TargetType="Label">
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="Grid.Column" Value="1" />
            </Style>
            <Style x:Key="FirstSearchItemFieldCaptionLabel" TargetType="Label" BasedOn="{StaticResource SearchItemFieldCaptionLabel}">
                <Setter Property="Margin" Value="8,4,8,0" />
            </Style>
            <Style x:Key="LastSearchItemFieldCaptionLabel" TargetType="Label" BasedOn="{StaticResource SearchItemFieldCaptionLabel}">
                <Setter Property="Margin" Value="8,0,8,4" />
            </Style>

            <Style x:Key="SearchItemFieldValueLabel" TargetType="Label">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="TextColor" Value="DimGray" />
                <Setter Property="Grid.Column" Value="2" />
            </Style>
            <Style x:Key="FirstSearchItemFieldValueLabel" TargetType="Label" BasedOn="{StaticResource SearchItemFieldValueLabel}">
                <Setter Property="Margin" Value="0,4,8,0" />
            </Style>
            <Style x:Key="LastSearchItemFieldValueLabel" TargetType="Label" BasedOn="{StaticResource SearchItemFieldValueLabel}">
                <Setter Property="Margin" Value="0,0,8,4" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollView
                Grid.RowSpan="3"
                HorizontalScrollBarVisibility="Never">
                <StackLayout Padding="0,56,0,48">
                    <StackLayout
                        Margin="16,16,16,0">
                        <Label
                            Text="Título o Temática"
                            TextColor="{StaticResource SecoundaryTextColor}" />
                        <Entry
                            BackgroundColor="{StaticResource DarkBackgroundColor}"
                            Text="{Binding Path=TitleTemathic}" />
                    </StackLayout>
                    <FlexLayout
                        x:Name="SearchFormResponsiveWrapper"
                        Margin="8,0,8,0"
                        Wrap="Wrap">
                        <StackLayout 
                            Margin="8"
                            WidthRequest="{Binding Source={x:Reference SearchFormResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidthConverter}}">
                            <Label
                                Text="Categoría"
                                TextColor="{StaticResource SecoundaryTextColor}" />
                            <Picker
                                BackgroundColor="{StaticResource DarkBackgroundColor}"
                                SelectedItem="{Binding Path=Category}"
                                ItemsSource="{Binding Path=PickableCategories}"
                                ItemDisplayBinding="{Binding Converter={StaticResource CategoryModelToTreeNameConverter}}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="8"
                            WidthRequest="{Binding Source={x:Reference SearchFormResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidthConverter}}">
                            <Label
                                Text="Año"
                                TextColor="{StaticResource SecoundaryTextColor}" />
                            <Picker
                                BackgroundColor="{StaticResource DarkBackgroundColor}"
                                SelectedItem="{Binding Path=Year}"
                                ItemsSource="{Binding Path=PickableYears}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="8"
                            WidthRequest="{Binding Source={x:Reference SearchFormResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidthConverter}}">
                            <Label
                                Text="País"
                                TextColor="{StaticResource SecoundaryTextColor}" />
                            <Picker
                                BackgroundColor="{StaticResource DarkBackgroundColor}"
                                SelectedItem="{Binding Path=Country}"
                                ItemsSource="{Binding Path=PickableCountries}"
                                ItemDisplayBinding="{Binding Path=Name}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="8"
                            WidthRequest="{Binding Source={x:Reference SearchFormResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidthConverter}}">
                            <Label
                                Text="Casa Productora"
                                TextColor="{StaticResource SecoundaryTextColor}" />
                            <Picker
                                BackgroundColor="{StaticResource DarkBackgroundColor}"
                                SelectedItem="{Binding Path=ProducerHouse}"
                                ItemsSource="{Binding Path=PickableProducerHouses}"
                                ItemDisplayBinding="{Binding Path=Name}" />
                        </StackLayout>
                    </FlexLayout>
                    <Grid
                        Margin="16,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0" Grid.ColumnSpan="2"
                            Text="Géneros"
                            TextColor="{StaticResource SecoundaryTextColor}" />
                        <Entry
                            Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{StaticResource DarkBackgroundColor}"
                            IsReadOnly="True"
                            Text="{Binding Path=Genres, Converter={StaticResource EmptyCollectionToJoinedStringBindingConverter}, Mode=OneWay}" />
                        <Button
                            Grid.Row="1" Grid.Column="1"
                            Text="Seleccionar"
                            Clicked="PickGenresButton_Clicked" />
                    </Grid>
                    <Grid
                        Margin="16,8,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0" Grid.ColumnSpan="2"
                            Text="Elenco"
                            TextColor="{StaticResource SecoundaryTextColor}" />
                        <Entry
                            Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{StaticResource DarkBackgroundColor}"
                            IsReadOnly="True"
                            Text="{Binding Path=Personalities, Converter={StaticResource EmptyCollectionToJoinedStringBindingConverter}}" />
                        <Button
                            Grid.Row="1" Grid.Column="1"
                            Text="Seleccionar" />
                    </Grid>
                    <Grid
                        Margin="16,8,16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0" Grid.ColumnSpan="2"
                            Text="Etiquetas"
                            TextColor="{StaticResource SecoundaryTextColor}" />
                        <Entry
                            Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{StaticResource DarkBackgroundColor}"
                            IsReadOnly="True"
                            Text="{Binding Path=Tags, Converter={StaticResource EmptyCollectionToJoinedStringBindingConverter}}" />
                        <Button
                            Grid.Row="1" Grid.Column="1"
                            Text="Seleccionar" />
                    </Grid>
                    <BoxView 
                        Margin="16,8"
                        Color="{StaticResource DarkBackgroundColor}"
                        HeightRequest="1" />
                    <StackLayout 
                        Margin="16,8"
                        Orientation="Horizontal">
                        <Button
                            BackgroundColor="{StaticResource PrimaryActionColor}"
                            Text="Buscar"
                            TextColor="Black"
                            Clicked="SearchFormCommitButton_Click" />
                        <Button 
                            Text="Recomenzar"
                            Clicked="SearchFormResetButton_Click" />
                    </StackLayout>
                    <StackLayout 
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=SubscriptorSearches, Converter={StaticResource NotNullToBooleanConverter}}">
                        <StackLayout.Background>
                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="0,1">
                                <GradientStop Color="{StaticResource DefaultBackgroundColor}" Offset="0.0" />
                                <GradientStop Color="{StaticResource DarkBackgroundColor}" Offset="1.0" />
                            </LinearGradientBrush>
                        </StackLayout.Background>
                        <Label
                            Margin="10,20,10,0"
                            Text="Mis búsquedas"
                            TextColor="{StaticResource SecoundaryTextColor}"
                            FontSize="{StaticResource Header5FontSize}" />
                        <ScrollView Orientation="Horizontal">
                            <FlexLayout
                                Padding="5,0"
                                BindableLayout.ItemsSource="{Binding Path=SubscriptorSearches}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid 
                                            WidthRequest="320"
                                            ColumnSpacing="0" RowSpacing="2"
                                            Margin="5,0,5,10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="SearchItem_Tapped" />
                                            </Grid.GestureRecognizers>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <BoxView 
                                                Grid.Column="0" Grid.RowSpan="8"
                                                Color="{StaticResource PrimaryAccentColor}"
                                                WidthRequest="6"/>
                                            <mg:GradientView Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="8">
                                                <mg:GradientView.GradientSource>
                                                    <mg:CssGradientSource>
                                                        <x:String>
                                                            <![CDATA[
                                                                radial-gradient(circle at left bottom, rgb(242, 242, 242) 0%, rgb(242, 242, 242) 6%, rgb(238, 238, 238) 6%, rgb(238, 238, 238) 15%, rgb(234, 234, 234) 15%, rgb(234, 234, 234) 47%, rgb(230, 230, 230) 47%, rgb(230, 230, 230) 54%, rgb(225, 225, 225) 54%, rgb(225, 225, 225) 56%, rgb(221, 221, 221) 56%, rgb(221, 221, 221) 90%, rgb(217, 217, 217) 90%, rgb(217, 217, 217) 100%)
                                                            ]]>
                                                        </x:String>
                                                    </mg:CssGradientSource>
                                                </mg:GradientView.GradientSource>
                                            </mg:GradientView>
                                            <Label
                                                Style="{StaticResource FirstSearchItemFieldCaptionLabel}"
                                                Grid.Row="0"
                                                Text="Título:" />
                                            <Label
                                                Style="{StaticResource FirstSearchItemFieldValueLabel}"
                                                Grid.Row="0"
                                                Text="{Binding Path=TitleTemathic, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="1"
                                                Text="Categoría:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="1"
                                                Text="{Binding Path=Category, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="2"
                                                Text="Año:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="2"
                                                Text="{Binding Path=Year, Converter={StaticResource InvalidYearToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="3"
                                                Text="País:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="3"
                                                Text="{Binding Path=Country, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="4"
                                                Text="Casa Productora:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="4"
                                                Text="{Binding Path=ProducerHouse, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="5"
                                                Text="Géneros:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="5"
                                                Text="{Binding Path=Genres, Converter={StaticResource NoEmptyCollectionToJoinedStringBindingConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="6"
                                                Text="Elenco:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="6"
                                                Text="{Binding Path=Personalities, Converter={StaticResource NoEmptyCollectionToJoinedStringBindingConverter}}" />
                                            <Label
                                                Style="{StaticResource LastSearchItemFieldCaptionLabel}"
                                                Grid.Row="7"
                                                Text="Etiquetas:" />
                                            <Label
                                                Style="{StaticResource LastSearchItemFieldValueLabel}"
                                                Grid.Row="7"
                                                Text="{Binding Path=Tags, Converter={StaticResource NoEmptyCollectionToJoinedStringBindingConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </ScrollView>
                    </StackLayout>
                    <StackLayout 
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=OtherSubscriptorsSearches, Converter={StaticResource NotNullToBooleanConverter}}">
                        <StackLayout.Background>
                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="0,1">
                                <GradientStop Color="{StaticResource DefaultBackgroundColor}" Offset="0.0" />
                                <GradientStop Color="{StaticResource DarkBackgroundColor}" Offset="1.0" />
                            </LinearGradientBrush>
                        </StackLayout.Background>
                        <Label
                            Margin="10,0,10,0"
                            Text="Otras personas buscaron"
                            TextColor="{StaticResource SecoundaryTextColor}"
                            FontSize="{StaticResource Header5FontSize}" />
                        <ScrollView Orientation="Horizontal">
                            <FlexLayout
                                Padding="5,0"
                                BindableLayout.ItemsSource="{Binding Path=OtherSubscriptorsSearches}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid 
                                            WidthRequest="320"
                                            ColumnSpacing="0" RowSpacing="2"
                                            Margin="5,0,5,10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="SearchItem_Tapped" />
                                            </Grid.GestureRecognizers>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <BoxView 
                                                Grid.Column="0" Grid.RowSpan="8"
                                                Color="{StaticResource PrimaryAccentColor}"
                                                WidthRequest="6"/>
                                            <mg:GradientView Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="8">
                                                <mg:GradientView.GradientSource>
                                                    <mg:CssGradientSource>
                                                        <x:String>
                                                            <![CDATA[
                                                                radial-gradient(circle at left bottom, rgb(242, 242, 242) 0%, rgb(242, 242, 242) 6%, rgb(238, 238, 238) 6%, rgb(238, 238, 238) 15%, rgb(234, 234, 234) 15%, rgb(234, 234, 234) 47%, rgb(230, 230, 230) 47%, rgb(230, 230, 230) 54%, rgb(225, 225, 225) 54%, rgb(225, 225, 225) 56%, rgb(221, 221, 221) 56%, rgb(221, 221, 221) 90%, rgb(217, 217, 217) 90%, rgb(217, 217, 217) 100%)
                                                            ]]>
                                                        </x:String>
                                                    </mg:CssGradientSource>
                                                </mg:GradientView.GradientSource>
                                            </mg:GradientView>
                                            <Label
                                                Style="{StaticResource FirstSearchItemFieldCaptionLabel}"
                                                Grid.Row="0"
                                                Text="Título:" />
                                            <Label
                                                Style="{StaticResource FirstSearchItemFieldValueLabel}"
                                                Grid.Row="0"
                                                Text="{Binding Path=TitleTemathic, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="1"
                                                Text="Categoría:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="1"
                                                Text="{Binding Path=Category, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="2"
                                                Text="Año:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="2"
                                                Text="{Binding Path=Year, Converter={StaticResource InvalidYearToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="3"
                                                Text="País:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="3"
                                                Text="{Binding Path=Country, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="4"
                                                Text="Casa Productora:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="4"
                                                Text="{Binding Path=ProducerHouse, Converter={StaticResource NullToReplacementStringConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="5"
                                                Text="Géneros:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="5"
                                                Text="{Binding Path=Genres, Converter={StaticResource NoEmptyCollectionToJoinedStringBindingConverter}}" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldCaptionLabel}"
                                                Grid.Row="6"
                                                Text="Elenco:" />
                                            <Label
                                                Style="{StaticResource SearchItemFieldValueLabel}"
                                                Grid.Row="6"
                                                Text="{Binding Path=Personalities, Converter={StaticResource NoEmptyCollectionToJoinedStringBindingConverter}}" />
                                            <Label
                                                Style="{StaticResource LastSearchItemFieldCaptionLabel}"
                                                Grid.Row="7"
                                                Text="Etiquetas:" />
                                            <Label
                                                Style="{StaticResource LastSearchItemFieldValueLabel}"
                                                Grid.Row="7"
                                                Text="{Binding Path=Tags, Converter={StaticResource NoEmptyCollectionToJoinedStringBindingConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </ScrollView>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <Grid
                Grid.Row="0"
                BackgroundColor="#CC000000"
                HeightRequest="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    FontFamily="Myriad Pro Regular">
                    <Label.FontSize>
                        <OnPlatform x:TypeArguments="x:Double" Default="36"></OnPlatform>
                    </Label.FontSize>
                    <Label.FormattedText>
                        <FormattedString>
                            <FormattedString.Spans>
                                <Span Text="Mediateca " TextColor="{StaticResource PrimaryTextColor}" />
                                <Span Text="Nuevo Mundo" TextColor="{StaticResource SecoundaryTextColor}" />
                            </FormattedString.Spans>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
            <Grid 
                Grid.Row="2"
                BackgroundColor="#CC000000"
                ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Text="Inicio"
                    TextColor="White"
                    Style="{StaticResource PivotButtonStyle}"
                    Clicked="HomePivotButton_Clicked">
                    <Button.ImageSource>
                        <FontImageSource
                            Glyph="&#xf4dc;"
                            Color="White"
                            FontFamily="Material Design Icons" />
                    </Button.ImageSource>
                </Button>
                <Button
                    Grid.Column="1"
                    Text="Catálogo"
                    TextColor="White"
                    Style="{StaticResource PivotButtonStyle}"
                    Clicked="LibraryPivotButton_Clicked">
                    <Button.ImageSource>
                        <FontImageSource
                            Glyph="&#xf638;"
                            Color="White"
                            FontFamily="Material Design Icons" />
                    </Button.ImageSource>
                </Button>
                <Button
                    Grid.Column="2"
                    Text="Buscar"
                    TextColor="{StaticResource PrimaryAccentColor}"
                    Style="{StaticResource PivotButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource
                            Glyph="&#xf349;"
                            Color="{StaticResource PrimaryAccentColor}"
                            FontFamily="Material Design Icons" />
                    </Button.ImageSource>
                </Button>
            </Grid>
            <Grid
                Grid.Row="1" Grid.RowSpan="2"
                IsVisible="{Binding Path=IsBusy}"
                BackgroundColor="#CC000000">
                <ActivityIndicator 
                    VerticalOptions="Center" HorizontalOptions="Center"
                    HeightRequest="48" WidthRequest="48"
                    IsRunning="True" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>