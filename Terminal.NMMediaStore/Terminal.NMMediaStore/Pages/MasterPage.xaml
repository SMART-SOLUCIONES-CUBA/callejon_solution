<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:mg="clr-namespace:MagicGradients;assembly=MagicGradients"
    xmlns:ffil="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Converters"
    xmlns:views="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Views"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Pages.MasterPage"
    x:Name="Page"
    BackgroundColor="#8a9ca8"
    Title="Mediateca">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrentStorageUsedBoxWidthConverter x:Key="CurrentStorageUsedBoxWidthConverter" Page="{x:Reference Page}" />
            <converters:VirtualStorageUsedBoxWidthConverter x:Key="VirtualStorageUsedBoxWidthConverter" Page="{x:Reference Page}" MinValue="12" />
            <converters:ImageModelToImageSourceConverter x:Key="ImageModelToImageSourceConverter" />
            <converters:StorageUsedBoxWidthToHeightConverter x:Key="StorageUsedBoxWidthToHeightConverter" MaxWidth="24" />
            <converters:StorageUsedBoxWidthToCornerRadiusConverter x:Key="StorageUsedBoxWidthToCornerRadiusConverter" MaxWidth="24" />
            <converters:MasterPageModelToVirtualStorageUsedSpaceConverter x:Key="MasterPageModelToVirtualStorageUsedSpaceConverter" />
            <converters:TimeSpanToFullStringConverter x:Key="TimeSpanToFullStringConverter" />

            <sscxftoolkitpresentationconverters:FileSizeLongToStringConverter x:Key="FileSizeLongToStringConverter" />
            <sscxftoolkitpresentationconverters:EnumerationToCountConverter x:Key="EnumerationToCountConverter" />
            <sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <mg:GradientView Grid.Row="0">
                <mg:GradientView.GradientSource>
                    <mg:CssGradientSource>
                        <x:String>
                            <![CDATA[
                                radial-gradient(circle at left bottom, rgb(242, 242, 242) 0%, rgb(242, 242, 242) 6%, rgb(238, 238, 238) 6%, rgb(238, 238, 238) 15%, rgb(234, 234, 234) 15%, rgb(234, 234, 234) 47%, rgb(230, 230, 230) 47%, rgb(230, 230, 230) 54%, rgb(225, 225, 225) 54%, rgb(225, 225, 225) 56%, rgb(221, 221, 221) 56%, rgb(221, 221, 221) 90%, rgb(217, 217, 217) 90%, rgb(217, 217, 217) 100%)
                            ]]>
                        </x:String>
                    </mg:CssGradientSource>
                </mg:GradientView.GradientSource>
            </mg:GradientView>
            <ScrollView
                x:Name="MainScrollView"
                Grid.Row="0"
                IsEnabled="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <BoxView 
                        IsVisible="{Binding Path=IsBusy}"
                        Grid.Column="0" 
                        BackgroundColor="#EF000000" />
                    <Grid Grid.Row="0">
                        <BoxView
                            BackgroundColor="{StaticResource PrimaryAccentColor}"
                            CornerRadius="0,0,20,20" />
                        <StackLayout 
                            Margin="20"
                            Spacing="0">
                            <ic:CircleImage
                                HorizontalOptions="Center" VerticalOptions="Center"
                                Margin="0,8"
                                BorderThickness="2"
                                BorderColor="Snow"
                                WidthRequest="{StaticResource MiddleAvatarSize}"
                                HeightRequest="{StaticResource MiddleAvatarSize}" 
                                Source="{Binding Path=Subscriptor.ImageSource}">
                            </ic:CircleImage>
                            <Label
                                HorizontalOptions="Center"
                                Text="{Binding Path=Subscriptor.Name}"
                                TextColor="Black"
                                FontSize="{StaticResource Header2FontSize}"
                                FontFamily="Myriad Pro Condensed Italic" />
                            <Label
                                HorizontalOptions="Center"
                                Text="{Binding Path=Subscriptor.LastName}"
                                TextColor="Black"
                                FontSize="{StaticResource Header3FontSize}"
                                FontFamily="Myriad Pro Condensed Italic" />
                            <Grid Margin="0,16,0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <BoxView
                                    Grid.RowSpan="2"
                                    BackgroundColor="{StaticResource AlternativeBackgroundColor}"
                                    CornerRadius="12"
                                    HeightRequest="80"/>
                                <Expander Grid.Row="0">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Column="0"
                                                Margin="8,8,0,0"
                                                Text="{Binding Path=Target.FamilyRepresentativeIconGlyph}"
                                                TextColor="White"
                                                FontSize="{StaticResource DefaultIconSize}"
                                                FontFamily="Material Design Icons" />
                                            <Label
                                                Grid.Column="1"
                                                IsVisible="{Binding Path=Target.Storage, Converter={StaticResource NullToBooleanConverter}}"
                                                Margin="0,8,0,0"
                                                LineBreakMode="TailTruncation"
                                                VerticalTextAlignment="Center"
                                                Text="Sin almacenamiento ..."
                                                TextColor="White"
                                                FontSize="{StaticResource Header4FontSize}"
                                                FontFamily="Myriad Pro Condensed" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="0,8,0,0"
                                                IsVisible="{Binding Path=Target.Storage, Converter={StaticResource NotNullToBooleanConverter}}"
                                                LineBreakMode="TailTruncation"
                                                VerticalTextAlignment="Center"
                                                Text="{Binding Path=Target.Storage.Caption}"
                                                TextColor="White"
                                                FontSize="{StaticResource Header4FontSize}"
                                                FontFamily="Myriad Pro Condensed" />
                                            <Label
                                                Grid.Column="2"
                                                Margin="0,12,8,0"
                                                VerticalOptions="Center"
                                                Padding="0"
                                                Text="&#xf140;"
                                                TextColor="White"
                                                FontSize="{StaticResource Header2FontSize}"
                                                FontFamily="Material Design Icons"
                                                WidthRequest="{StaticResource DefaultIconSize}" HeightRequest="{StaticResource DefaultIconSize}">
                                                <Label.Triggers>
                                                    <DataTrigger 
                                                        TargetType="Label" 
                                                        Binding="{Binding Source={RelativeSource AncestorType={x:Type Expander}}, Path=IsExpanded}"
                                                        Value="True">
                                                        <Setter Property="Text" Value="&#xf143;" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <Grid Margin="12,12,12,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <BoxView
                                                Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                VerticalOptions="Center"
                                                BackgroundColor="{StaticResource SecoundaryDarkActionColor}"
                                                HeightRequest="24" WidthRequest="24"
                                                CornerRadius="12" />
                                            <Label
                                                Grid.Column="1" Grid.Row="0"
                                                Text="Espacio ocupado ahora"/>
                                            <Label
                                                Grid.Column="1" Grid.Row="1"
                                                IsVisible="{Binding Path=Target.Storage, Converter={StaticResource NullToBooleanConverter}}"
                                                Text="-"
                                                TextColor="{StaticResource SecoundaryTextColor}" />
                                            <Label
                                                Grid.Column="1" Grid.Row="1"
                                                IsVisible="{Binding Path=Target.Storage, Converter={StaticResource NotNullToBooleanConverter}}"
                                                TextColor="{StaticResource SecoundaryTextColor}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Path=Target.Storage.UsedSpace, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                                        <Span Text="  usados de " />
                                                        <Span Text="{Binding Path=Target.Storage.TotalSpace, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <BoxView
                                                Grid.Column="0" Grid.Row="2" Grid.RowSpan="2"
                                                VerticalOptions="Center"
                                                BackgroundColor="{StaticResource PrimaryDarkActionColor}"
                                                HeightRequest="24" WidthRequest="24"
                                                CornerRadius="12" />
                                            <Label
                                                Grid.Column="1" Grid.Row="2"
                                                Text="Espacio ocupado después"/>
                                            <Label
                                                Grid.Column="1" Grid.Row="3"
                                                IsVisible="{Binding Path=Target.Storage, Converter={StaticResource NullToBooleanConverter}}"
                                                Text="-"
                                                TextColor="{StaticResource SecoundaryTextColor}" />
                                            <Label
                                                Grid.Column="1" Grid.Row="3"
                                                IsVisible="{Binding Path=Target.Storage, Converter={StaticResource NotNullToBooleanConverter}}"
                                                TextColor="{StaticResource SecoundaryTextColor}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <views:VirtualStorageSpaceUseSpan Text="{Binding Converter={StaticResource MasterPageModelToVirtualStorageUsedSpaceConverter}}" x:Name="VirtualStoreUsedSpaceSpan" />
                                                        <Span Text="  usados de " />
                                                        <Span Text="{Binding Path=Target.Storage.TotalSpace, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <BoxView 
                                                Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4"
                                                Margin="0,10,0,6"
                                                Color="{StaticResource DefaultBackgroundColor}"
                                                HeightRequest="2" />
                                            <Button
                                                IsEnabled="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                                                Grid.ColumnSpan="2" Grid.Row="5"
                                                ContentLayout="Right,6"
                                                Text="Seleccionar Almacenamiento"
                                                Clicked="PickStorageDeviceButton_Clicked">
                                                <Button.ImageSource>
                                                    <FontImageSource
                                                        Glyph="&#xfa76;"
                                                        Size="24"
                                                        FontFamily="Material Design Icons" />
                                                </Button.ImageSource>
                                            </Button>
                                        </Grid>
                                    </Expander.Content>
                                </Expander>                                
                                <views:StorageSpaceReferenceBoxView
                                    x:Name="StorageSpaceReferenceBoxView"
                                    Grid.Row="1"
                                    BackgroundColor="White"
                                    CornerRadius="12"
                                    HeightRequest="24" />
                                <BoxView
                                    Grid.Row="1"
                                    BackgroundColor="{StaticResource PrimaryDarkActionColor}"
                                    CornerRadius="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource StorageUsedBoxWidthToCornerRadiusConverter}}"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource StorageUsedBoxWidthToHeightConverter}}"
                                    WidthRequest="{Binding Source={x:Reference StorageSpaceReferenceBoxView}, Path=Width, Converter={StaticResource VirtualStorageUsedBoxWidthConverter}}"
                                    HorizontalOptions="Start" VerticalOptions="Center" />
                                <BoxView
                                    Grid.Row="1"
                                    BackgroundColor="{StaticResource SecoundaryDarkActionColor}"
                                    CornerRadius="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource StorageUsedBoxWidthToCornerRadiusConverter}}"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource StorageUsedBoxWidthToHeightConverter}}"
                                    WidthRequest="{Binding Source={x:Reference StorageSpaceReferenceBoxView}, Path=Width, Converter={StaticResource CurrentStorageUsedBoxWidthConverter}}"
                                    HorizontalOptions="Start" VerticalOptions="Center" />
                            </Grid>
                        </StackLayout>
                    </Grid>
                    <Grid Grid.Row="1" Margin="12,12,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0" Grid.Column="0"
                            Text="&#xf9e8;"
                            TextColor="Black"
                            FontSize="{StaticResource SmallIconSize}"
                            FontFamily="Material Design Icons" />
                        <Label 
                            Grid.Row="0" Grid.Column="1"
                            VerticalOptions="Center"
                            Text="Vista rápida"
                            TextColor="Black"
                            FontSize="{StaticResource Header5FontSize}"/>
                        <BoxView 
                            Grid.ColumnSpan="2" Grid.Row="1"
                            Color="Black"
                            HeightRequest="2" />
                    </Grid>
                    <StackLayout 
                        Grid.Row="2"
                        Margin="12,8,0,12"
                        BindableLayout.ItemsSource="{Binding Path=FetchOrderAudioVisuals}">
                        <BindableLayout.EmptyView>
                            <Label
                                Text="No se han agregado elementos"
                                TextColor="DimGray" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="#AAF2F2F2" 
                                    HeightRequest="90">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ffil:CachedImage 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Aspect="AspectFill"
                                        Source="{Binding Path=PosterImage, Converter={StaticResource ImageModelToImageSourceConverter}}"
                                        DownsampleHeight="90"
                                        DownsampleUseDipUnits="True"
                                        CacheType="Disk"
                                        CacheDuration="8760:00:00" />
                                    <Label 
                                        Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                        Margin="0,4,0,0"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Path=Title}"
                                        TextColor="{StaticResource DarkBackgroundColor}"
                                        FontSize="{StaticResource Header4FontSize}"
                                        FontFamily="Myriad Pro Condensed" />
                                    <Button
                                        Grid.RowSpan="2" Grid.Column="5"
                                        VerticalOptions="Start"
                                        Padding="2,4"
                                        Text="&#xf1d9;"
                                        TextColor="{StaticResource PrimaryDarkActionColor}"
                                        FontSize="{StaticResource SmallIconSize}"
                                        FontFamily="Material Design Icons"
                                        Clicked="FetchOrderAudioVisualOptionButton_Clicked" />
                                    <Label 
                                        Grid.Row="1" Grid.Column="1"
                                        Margin="0,0,0,6"
                                        BackgroundColor="{StaticResource DarkBackgroundColor}"
                                        Padding="6,4"
                                        Text="{Binding Path=Quality}"/>
                                    <Label 
                                        Grid.Row="1" Grid.Column="2"
                                        Margin="0,0,0,6"
                                        BackgroundColor="{StaticResource DarkBackgroundColor}"
                                        Padding="6,4"
                                        Text="{Binding Path=FileSize, Converter={StaticResource FileSizeLongToStringConverter}}"/>
                                    <Label 
                                        IsVisible="{Binding Path=HasSubtitle}"
                                        Margin="0,0,0,6"
                                        Grid.Row="1" Grid.Column="3"
                                        BackgroundColor="{StaticResource DarkBackgroundColor}"
                                        Padding="6,4,7,4"
                                        Text="+SUB"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <ContentView
                        IsVisible="{Binding Path=IsBusy}"
                        Grid.Row="1" Grid.RowSpan="2">
                        <Grid
                            Grid.Row="2"
                            BackgroundColor="#EF000000">
                            <StackLayout 
                                VerticalOptions="Center" HorizontalOptions="Center"
                                WidthRequest="280">
                                <ActivityIndicator 
                                    VerticalOptions="Center" HorizontalOptions="Center"
                                    HeightRequest="{StaticResource MiddleIconSize}" WidthRequest="{StaticResource MiddleIconSize}"
                                    IsRunning="True" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding Path=BusyProgressMessage}"
                                    FontSize="{StaticResource Header4FontSize}" />
                                <StackLayout
                                    Margin="0,10,0,0"
                                    IsVisible="{Binding Path=DownloadingIndex}">
                                    <Label
                                        TextColor="{StaticResource SecoundaryTextColor}"
                                        FontSize="{StaticResource MiddleTextFontSize}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Audio Visual " />
                                                <Span Text="{Binding Path=DownloadingIndex}" />
                                                <Span Text=" de " />
                                                <Span Text="{Binding Path=MasterBindingContext.FetchOrderAudioVisuals, Converter={StaticResource EnumerationToCountConverter}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <ProgressBar Progress="{Binding Path=ProgressPercent}" />
                                    <Label
                                        TextColor="{StaticResource SecoundaryTextColor}"
                                        HorizontalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Path=TransferProgress, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                                <Span Text=" de " />
                                                <Span Text="{Binding Path=TransferLength, Converter={StaticResource FileSizeLongToStringConverter}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label
                                        Margin="0,6,0,0"
                                        TextColor="{StaticResource SecoundaryTextColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Tiempo transcurrido: " />
                                                <Span Text="{Binding Path=Time, Converter={StaticResource TimeSpanToFullStringConverter}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                            </StackLayout>
                        </Grid>
                    </ContentView>
                </Grid>
            </ScrollView>            
            <Button
                Grid.Row="1"
                BackgroundColor="{StaticResource SecoundaryDarkActionColor}"
                ContentLayout="Right,10"
                Text="Ir al Centro de Descargas"
                Clicked="FullShoppingCartButton_Clicked">
                <Button.ImageSource>
                    <FontImageSource
                        Glyph="&#xf13e;"
                        FontFamily="Material Design Icons" />
                </Button.ImageSource>
            </Button>
        </Grid>    
    </ContentPage.Content>
</ContentPage>