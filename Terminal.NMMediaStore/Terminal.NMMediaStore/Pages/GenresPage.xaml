<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Models.Page"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:mg="clr-namespace:MagicGradients;assembly=MagicGradients"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.NMMediaStore.Pages.GenresPage"
    x:TypeArguments="pagemodels:GenresPageModel"
    NavigationPage.HasNavigationBar="False"
    Style="{StaticResource BasePageStyle}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="180" ChildAbsoluteHorizontalMargin="10" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid ColumnSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ScrollView Grid.RowSpan="2" Orientation="Vertical">
                <StackLayout
                    Padding="5,56,5,5"
                    Spacing="4">
                    <Label
                        Margin="12,12,12,0"
                        Text="Géneros"
                        TextColor="{StaticResource SecoundaryTextColor}"
                        FontSize="{StaticResource Header5FontSize}" />
                    <Grid>
                        <FlexLayout
                            Wrap="Wrap"
                            AlignContent="Start" AlignItems="Start"
                            BindableLayout.ItemsSource="{Binding Path=Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid 
                                        WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}" HeightRequest="102"
                                        Margin="5">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="GenreItem_Tapped" />
                                        </Grid.GestureRecognizers>
                                        <mg:GradientView VerticalOptions="FillAndExpand" >
                                            <mg:GradientView.GradientSource>
                                                <mg:CssGradientSource>
                                                    <x:String>
                                                        <![CDATA[
                                                            linear-gradient(45deg, #3b6baf 0%,#3b6baf 31%,#375f97 31%,#375f97 46%,#33537f 46%,#33537f 56%,#304664 56%,#304664 93%,#282e34 93%,#282e34 100%)
                                                        ]]>
                                                    </x:String>
                                                </mg:CssGradientSource>
                                            </mg:GradientView.GradientSource>
                                        </mg:GradientView>
                                        <Label
                                            Margin="10,6"
                                            Text="{Binding Path=Name}"
                                            TextColor="White"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3"
                                            FontSize="{StaticResource Header3FontSize}"
                                            FontFamily="Myriad Pro Condensed Italic" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <ActivityIndicator
                            Margin="12"
                            HorizontalOptions="Center"
                            HeightRequest="32" WidthRequest="32"
                            IsVisible="{Binding Path=IsBusy}"
                            IsRunning="{Binding Path=IsBusy}" />
                    </Grid>
                </StackLayout>               
            </ScrollView>
            <Grid
                Grid.Row="0"
                BackgroundColor="#CC000000"
                HeightRequest="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Text="&#xfcba;"
                    TextColor="White"
                    FontSize="{StaticResource Header2FontSize}"
                    FontFamily="Material Design Icons"
                    CornerRadius="12"
                    WidthRequest="{StaticResource DefaultIconSize}" HeightRequest="{StaticResource DefaultIconSize}"
                    Clicked="AlternativeBackButton_Clicked" />
                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    FontFamily="Myriad Pro Regular">
                    <Label.FontSize>
                        <OnPlatform x:TypeArguments="x:Double" Default="36"></OnPlatform>
                    </Label.FontSize>
                    <Label.FormattedText>
                        <FormattedString>
                            <FormattedString.Spans>
                                <Span Text="Mediateca " TextColor="{StaticResource PrimaryTextColor}" />
                                <Span Text="Nuevo Mundo" TextColor="{StaticResource SecoundaryTextColor}" />
                            </FormattedString.Spans>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
        </Grid>        
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>