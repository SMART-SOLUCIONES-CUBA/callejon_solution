<UserControl x:Class="SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls.StartingBillboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Canvas Grid.RowSpan="2" Grid.Column="0">
            <Image Name="BackboardImage" Stretch="UniformToFill" />
        </Canvas>
        <Grid Grid.Column="0" Grid.Row="1">
            <ProgressBar Name="WeitingProgressBar" Height="5" Foreground="#FFE08452" IsIndeterminate="True" Background="#BFE6E6E6" BorderBrush="#00BCBCBC" Visibility="Hidden" />
        </Grid>
    </Grid>
</UserControl>
