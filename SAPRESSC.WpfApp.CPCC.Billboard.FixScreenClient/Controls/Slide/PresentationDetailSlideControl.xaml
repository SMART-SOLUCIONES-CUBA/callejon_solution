<UserControl x:Class="SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls.Slide.PresentationDetailSlideControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls"
             xmlns:frames="clr-namespace:SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls.Frame"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280" Loaded="UserControl_Loaded">
    <Grid>
        <Canvas>
            <Grid Name="WrapContainer" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.12*" />
                        <RowDefinition Height="0.14*" />
                        <RowDefinition Height="0.18*" />
                        <RowDefinition Height="0.4*" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" HorizontalAlignment="Left">
                        <TextBlock Name="CinemaNameTextBlock" FontFamily="Helvetica LT Std" FontStretch="Condensed" FontWeight="Medium">Sala Nuevo Mundo</TextBlock>
                    </Viewbox>
                    <Viewbox Grid.Row="1" HorizontalAlignment="Left">
                        <TextBlock Name="RoomNameTextBlock" FontFamily="Helvetica LT Std" FontStretch="Condensed" FontWeight="Bold">Sala Nuevo Mundo</TextBlock>
                    </Viewbox>
                    <Viewbox Grid.Row="2" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock Foreground="#FF404040" Name="TimesTextBlock" FontFamily="Helvetica LT Std" FontStretch="Condensed">9:00 AM / 1:00 PM / 3:00 PM / 5:00 PM</TextBlock>
                    </Viewbox>
                    <Viewbox Grid.Row="3" HorizontalAlignment="Left">
                        <TextBlock Name="TitleTextBlock" Foreground="#FFC22926" FontFamily="Helvetica LT Std Compressed">HOTEL TRANSILVANIA ll</TextBlock>
                    </Viewbox>
                    <controls:ContentFrameCarouselControl x:Name="ContentFrameCarousel" Grid.Row="4" Margin="0,10,0,0" />
                </Grid>
                <Border Grid.Column="0" BorderThickness="10" BorderBrush="#FF808a8e">
                    <Image Name="PosterImage" />
                </Border>
                <frames:BillboardSidebarFrameControl x:Name="BillboardSidebar" Grid.Column="2" />
            </Grid>
        </Canvas>
        <Canvas Name="ForegroundAnimationContainer" />
    </Grid>
</UserControl>
