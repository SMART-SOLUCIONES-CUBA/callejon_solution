<UserControl x:Class="SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls.Frame.PresentationOverviewFrameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls.Frame"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="334">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Name="PosterImageBorder" Grid.Column="0" BorderThickness="10" BorderBrush="#FF808a8e">
            <Image Name="PosterImage" Stretch="UniformToFill" />
        </Border>
        <TextBlock Grid.Row="1" Margin="0,10,0,4" FontSize="28" TextTrimming="CharacterEllipsis" Name="TitleTextBlock" Foreground="#FFC22926" FontFamily="Helvetica LT Std" FontStretch="ExtraCondensed">HOTEL TRANSILVANIA II</TextBlock>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Grid.Column="0" Foreground="#FF404040" FontFamily="Helvetica LT Std" FontStretch="Condensed" Margin="0,0,4,0" FontSize="21">»</TextBlock>
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock FontSize="21" TextTrimming="CharacterEllipsis" Name="TimesTextBlock" Foreground="#FF404040" FontFamily="Helvetica LT Std" FontStretch="Condensed">10:00 AM</TextBlock>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock FontSize="21" Name="CountryTextBlock" FontFamily="Helvetica LT Std" FontStretch="Condensed">EE.UU.</TextBlock>
                    <TextBlock FontSize="21" Margin="3,0" FontFamily="Helvetica LT Std" FontStretch="Condensed">/</TextBlock>
                    <TextBlock FontSize="21" Name="YearTextBlock" FontFamily="Helvetica LT Std" FontStretch="Condensed">2015</TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
