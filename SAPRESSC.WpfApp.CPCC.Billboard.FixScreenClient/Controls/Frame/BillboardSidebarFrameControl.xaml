<UserControl x:Class="SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls.Frame.BillboardSidebarFrameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="208" Loaded="UserControl_Loaded">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Name="DateMonth" TextAlignment="Center" Padding="5,0" Foreground="White" Background="Black" FontFamily="Kozuka Gothic Pro L" FontSize="20pt">NOVIEMBRE</TextBlock>
        <TextBlock Grid.Row="1" Name="DateNumericDay" FontSize="115pt" Foreground="#FF3C3C3C" Background="#FF939393" TextAlignment="Center" Height="115pt" LineHeight="160pt" LineStackingStrategy="BlockLineHeight" FontFamily="Kozuka Gothic Pro EL">24</TextBlock>
        <Border Grid.Row="2" BorderThickness="0" Background="#FF939393" Padding="10,0" CornerRadius="0,0,0,10" Margin="0,-1,0,0">
            <TextBlock Name="DateLiteralDay" TextAlignment="Center" FontFamily="Kozuka Gothic Pro" FontSize="19pt" Foreground="#FF2C2C2C" Text="JUEVES">
            </TextBlock>
        </Border>
        <StackPanel Name="PlaylistStatusItemsContainer" Grid.Row="3" Margin="0,7,0,0">

        </StackPanel>
    </Grid>
</UserControl>
