<UserControl x:Class="SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls.Frame.PlaylistItemOverviewFrameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartSolucionesCuba.SAPRESSC.WpfApp.CPCC.Billboard.FixScreenClient.Controls"
             mc:Ignorable="d" >
    <Border Name="WrapContainer" BorderThickness="0" Background="#FFA0A0A0" Padding="10,8" CornerRadius="10,0,0,10">
        <StackPanel>
            <TextBlock Name="TagTextBlock" TextTrimming="CharacterEllipsis" Text="Tag" FontFamily="Myriad Pro" FontStretch="Condensed" FontStyle="Italic" FontSize="11pt" FontWeight="Bold"></TextBlock>
            <TextBlock Name="TitleTextBlock" TextTrimming="CharacterEllipsis" Text="Title" FontSize="15pt" FontFamily="Helvetica LT Std Compressed"></TextBlock>
            <TextBlock Name="PrimaryLineTextBlock" TextTrimming="CharacterEllipsis" Text="Primary Line" FontSize="11pt" FontFamily="Helvetica LT Std Cond"></TextBlock>
            <TextBlock Name="SecundaryLineTextBlock" TextTrimming="CharacterEllipsis" Text="Secundary Line" FontSize="11pt" FontFamily="Helvetica LT Std Cond"></TextBlock>
        </StackPanel>
    </Border>
    
</UserControl>
