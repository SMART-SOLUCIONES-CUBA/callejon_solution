<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:skiasharpformsviews="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Converters"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.DatabaseShareReceivePage"
    x:Name="Page"
    NavigationPage.BackButtonTitle="Atrás"
    Title="Recibir de un Amigo">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PageHeightToCuadrateSideSizeConverter x:Key="PageHeightToCuadrateSideSizeConverter" Page="{x:Reference Page}" />
            <converters:FriendDataModelToImageSourceConverter x:Key="FriendDataModelToImageSourceConverter" />
            <!--<sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBooleanConverter" />-->
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Código QR"
            Order="Primary"
            Clicked="QrCodeScanToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xf433;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <Grid
                HorizontalOptions="Center" VerticalOptions="Center"
                WidthRequest="{Binding Source={x:Reference Page}, Path=Height, Converter={StaticResource PageHeightToCuadrateSideSizeConverter}}"
                HeightRequest="{Binding Source={x:Reference Page}, Path=Height, Converter={StaticResource PageHeightToCuadrateSideSizeConverter}}">
                <skiasharpformsviews:SKCanvasView
                    x:Name="CanvasView"
                    IsVisible="{Binding Path=IsBusy}"
                    PaintSurface="SKCanvasView_PaintSurface"/>
                <Grid
                    BindableLayout.ItemsSource="{Binding Path=Candidates}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Grid.Column="{Binding Path=GridColumn}" Grid.Row="{Binding Path=GridRow}"
                                Margin="1"
                                RowSpacing="4">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SenderCandidateTapGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ic:CircleImage
                                    Grid.Row="0"
                                    Source="{Binding Path=Friend, Converter={StaticResource FriendDataModelToImageSourceConverter}}"
                                    HorizontalOptions="Center"
                                    BorderThickness="2"
                                    BorderColor="{StaticResource SecoundaryBrandColor}" />
                                <Label
                                    Grid.Row="1"
                                    Margin="3,0"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Path=Friend.Terminal.Name}"
                                    FontSize="Micro" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
                <Grid
                    IsVisible="{Binding Path=Sender, Converter={StaticResource NotNullToBooleanConverter}}"
                    HorizontalOptions="Center" VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ic:CircleImage
                        Grid.Row="0"
                        Source="{Binding Path=Sender, Converter={StaticResource FriendDataModelToImageSourceConverter}}"
                        HorizontalOptions="Center"
                        BorderThickness="2"
                        BorderColor="{StaticResource SecoundaryBrandColor}" />
                    <Label
                        Grid.Row="1"
                        Margin="3,0"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Path=Sender.Terminal.Name}"
                        FontSize="Micro" />
                </Grid>
            </Grid>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>