<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:skiasharpformsviews="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Converters"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.DatabaseShareReceivePage"
    x:Name="Page"
    ios:Page.UseSafeArea="True">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PageHeightToCuadrateSideSizeConverter x:Key="PageHeightToCuadrateSideSizeConverter" Page="{x:Reference Page}" />
            <converters:FriendDataModelToImageSourceConverter x:Key="FriendDataModelToImageSourceConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="PageIsEnabledToTextColorConverter" FalseString="LightGray" TrueString="Black" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="PageIsEnabledToImageButtonForegroundColorConverter" FalseString="LightGray" TrueString="{StaticResource SecoundaryBrandColor}" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="FactorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label 
                Grid.Column="1" Grid.Row="0"
                Margin="20,20,20,10"
                HorizontalTextAlignment="Center"
                Text="Recibir Datos"
                TextColor="{StaticResource PrimaryBrandColor}">
                <Label.FontSize>
                    <OnPlatform x:TypeArguments="x:Double">
                        <On Platform="iOS" Value="30" />
                        <On Platform="Android" Value="28" />
                    </OnPlatform>
                </Label.FontSize>
            </Label>
            <Button 
                Grid.Column="2" Grid.Row="0"
                HorizontalOptions="End" VerticalOptions="Start"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize, Converter={StaticResource FactorConverter}, ConverterParameter=2}"
                HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize, Converter={StaticResource FactorConverter}, ConverterParameter=2}"
                Text="&#xf5ad;"
                TextColor="{StaticResource PrimaryBrandColor}"
                FontFamily="Material Design Icons"
                FontSize="Large"
                Clicked="CloseButton_Clicked">
                <Button.Margin>
                    <OnPlatform x:TypeArguments="Thickness" Default="10">
                        <On Platform="iOS" Value="10,5,10,10" />
                    </OnPlatform>
                </Button.Margin>
            </Button>
            <Grid
                Grid.ColumnSpan="3" Grid.RowSpan="2"
                IsVisible="{Binding Path=IsBusy}"
                HorizontalOptions="Center" VerticalOptions="Center"
                WidthRequest="{Binding Source={x:Reference Page}, Path=Height, Converter={StaticResource PageHeightToCuadrateSideSizeConverter}}"
                HeightRequest="{Binding Source={x:Reference Page}, Path=Height, Converter={StaticResource PageHeightToCuadrateSideSizeConverter}}">
                <skiasharpformsviews:SKCanvasView
                    x:Name="CanvasView"
                    PaintSurface="SKCanvasView_PaintSurface"/>
                <Grid
                    BindableLayout.ItemsSource="{Binding Path=Candidates}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Grid.Column="{Binding Path=GridColumn}" Grid.Row="{Binding Path=GridRow}"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                Margin="1"
                                RowSpacing="4">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SenderCandidateTapGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ic:CircleImage
                                    Grid.Row="0"
                                    Source="{Binding Path=Friend, Converter={StaticResource FriendDataModelToImageSourceConverter}}"
                                    HorizontalOptions="Center"
                                    BorderThickness="2"
                                    BorderColor="{StaticResource SecoundaryBrandColor}" />
                                <Label
                                    Grid.Row="1"
                                    Margin="3,0"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Path=Friend.Terminal.Name}"
                                    FontSize="Micro" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
                <Grid
                    IsVisible="{Binding Path=Sender, Converter={StaticResource NotNullToBooleanConverter}}"
                    HorizontalOptions="Center" VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ic:CircleImage
                        Grid.Row="0"
                        Source="{Binding Path=Sender.Friend, Converter={StaticResource FriendDataModelToImageSourceConverter}}"
                        HorizontalOptions="Center"
                        BorderThickness="2"
                        BorderColor="{StaticResource SecoundaryBrandColor}" />
                    <Label
                        Grid.Row="1"
                        Margin="3,0"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Path=Sender.Friend.Terminal.Name}"
                        FontSize="Micro" />
                </Grid>
            </Grid>
            <StackLayout
                Grid.ColumnSpan="3" Grid.RowSpan="2"
                VerticalOptions="Center"
                IsVisible="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}">
                <Label
                    HorizontalOptions="Center"
                    Text="&#xfbbd;"
                    TextColor="{Binding Source={x:Reference Page}, Path=IsEnabled, Converter={StaticResource PageIsEnabledToTextColorConverter}}"
                    FontFamily="Material Design Icons"
                    FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=ProfileOverviewImageSize}" />
                <Label
                    Margin="20"
                    HorizontalTextAlignment="Center"
                    TextColor="{Binding Source={x:Reference Page}, Path=IsEnabled, Converter={StaticResource PageIsEnabledToTextColorConverter}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Su dispositivo no esta conectado a una red. Debe unirse a una manualmente o escanear un Código QR (" />
                            <Span Text="&#xf433;" FontFamily="Material Design Icons" />
                            <Span Text=") para unirse a un punto de acceso WiFi." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <ImageButton
                    HorizontalOptions="Center"
                    BackgroundColor="Transparent"
                    IsEnabled="{Binding Source={x:Reference Page}, Path=IsEnabled}"
                    Clicked="QrCodeScanButton_Clicked">
                    <ImageButton.Source>
                        <FontImageSource
                            Color="{Binding Source={x:Reference Page}, Path=IsEnabled, Converter={StaticResource  PageIsEnabledToImageButtonForegroundColorConverter}}"
                            FontFamily="Material Design Icons"
                            Glyph="&#xf433;"
                            Size="48" />
                    </ImageButton.Source>
                </ImageButton>
            </StackLayout>
            <StackLayout                
                Grid.ColumnSpan="3" Grid.Row="1"
                Margin="20"
                VerticalOptions="End">
                <ProgressBar
                    IsVisible="{Binding Path=IsReceivingBundle}"
                    ProgressColor="{StaticResource PrimaryBrandColor}"
                    Progress="{Binding Path=BundleReceivingProgress}">
                    <ProgressBar.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="iOS" Value="0,10" />
                        </OnPlatform>
                    </ProgressBar.Margin>
                </ProgressBar>
                <Label
                    HorizontalTextAlignment="Center"
                    Text="{Binding Path=BusyProgressMessage}" />
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>