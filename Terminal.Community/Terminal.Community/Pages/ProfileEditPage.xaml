<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:jmci="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Converters"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Views.Rendered"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.ProfileEditPage"
    NavigationPage.BackButtonTitle="Cancelar"
    Title="Editar Perfil de Usuario">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FlextLayoutToResponsiveItemWidthConverter x:Key="FlextLayoutToResponsiveItemWidth" ItemMinWidth="280" ItemHorizontalMargin="0" />

            <sscxftoolkitpresentationconverters:BoolToBinaryConverter x:Key="BoolToBinary" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="Factor" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="Fraction" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBoolean" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Guardar" Order="Primary" Clicked="SaveButton_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <StackLayout Margin="10">
                    <Grid>
                        <jmci:CircleImage
                            x:Name="ProfileImage"
                            HorizontalOptions="Center"
                            BorderThickness="2"
                            BorderColor="{StaticResource SecoundaryBrandColor}"
                            Margin="0,50,0,20"
                            HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}"
                            WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}"/>

                        <Button                            
                            Margin="0,50,0,20"
                            HorizontalOptions="Center"
                            BackgroundColor="#33000000"
                            BorderRadius="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize, Converter={StaticResource Fraction}, ConverterParameter=2}"
                            HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}"
                            WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}"
                            FontFamily="Iconmonstr Iconic"
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize, Converter={StaticResource Fraction}, ConverterParameter=3}"
                            Text="&#xE020;"
                            TextColor="#AAFFFFFF"
                            Clicked="PickImageButton_Clicked" />
                    </Grid>
                    <FlexLayout
                        x:Name="ResponsiveWrapper"
                        Margin="10"
                        Wrap="Wrap">
                        <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                            <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                                <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                                <Label
                                    Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                    Text="Nombre(s)" />
                            </StackLayout>
                            <Entry
                                Margin="10"
                                Text="{Binding Path=Profile.FirstName}"
                                FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventDefaultStyleFontSize}" />
                        </StackLayout>
                        <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                            <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                                <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                                <Label
                                    Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                    Text="Apellidos" />
                            </StackLayout>
                            <Entry 
                                Margin="10"
                                Text="{Binding Path=Profile.LastName}"
                                FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventDefaultStyleFontSize}" />
                        </StackLayout>
                        <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                            <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                                <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                                <Label
                                    Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                    Text="Sexo" />
                            </StackLayout>
                            <Picker 
                                Margin="10"
                                SelectedIndex="{Binding Path=Profile.IsMale, Converter={StaticResource BoolToBinary}}" 
                                HorizontalOptions="FillAndExpand"
                                FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventDefaultStyleFontSize}">
                                <Picker.Items>
                                    <x:String>Femenino</x:String>
                                    <x:String>Masculino</x:String>
                                </Picker.Items>
                            </Picker>
                        </StackLayout>
                        <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                            <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                                <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                                <Label
                                    Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                    Text="Teléfono" />
                            </StackLayout>
                            <Entry 
                                Margin="10"
                                Keyboard="Telephone"
                                Text="{Binding Path=Profile.Phone}"
                                FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventDefaultStyleFontSize}" />
                        </StackLayout>                        
                        <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                            <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                                <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                                <Label
                                    Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                    Text="Correo Electrónico" />
                            </StackLayout>
                            <Entry 
                                Margin="10"
                                Keyboard="Email"
                                Text="{Binding Path=Profile.Email}"
                                FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventDefaultStyleFontSize}" />
                        </StackLayout>                       
                        <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                            <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                                <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                                <Label
                                    Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                    Text="Fecha de Nacimiento" />
                            </StackLayout>
                            <DatePicker
                                MinimumDate="1/1/1900"
                                Margin="10"
                                Date="{Binding Path=Profile.BornDate}"
                                FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventDefaultStyleFontSize}" />
                        </StackLayout>
                    </FlexLayout>
                    <StackLayout Orientation="Horizontal" Padding="10,0">
                        <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                        <Label
                            Style="{StaticResource BlockquoteHeaderLabelStyle}"
                            Text="Resumen" />
                    </StackLayout>
                    <renderedviews:ExtendedEditor
                        Margin="20,10"
                        HeightRequest="200"
                        Text="{Binding Path=Profile.About}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventDefaultStyleFontSize}">
                        <renderedviews:ExtendedEditor.BorderColor>
                            <OnPlatform x:TypeArguments="Color">
                                <On Platform="iOS" Value="LightGray" />
                                <On Platform="Android" Value="{StaticResource PrimaryBrandColor}" />
                            </OnPlatform>
                        </renderedviews:ExtendedEditor.BorderColor>
                        <renderedviews:ExtendedEditor.BorderWidth>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="iOS" Value="1" />
                                <On Platform="Android" Value="4" />
                            </OnPlatform>
                        </renderedviews:ExtendedEditor.BorderWidth>
                        <renderedviews:ExtendedEditor.CornerRadius>
                            <OnPlatform x:TypeArguments="x:Int32">
                                <On Platform="iOS" Value="6" />
                                <On Platform="Android" Value="16" />
                            </OnPlatform>
                        </renderedviews:ExtendedEditor.CornerRadius>
                    </renderedviews:ExtendedEditor>
                </StackLayout>
            </ScrollView>
            <ContentView
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#EEFFFFFF">
                <StackLayout VerticalOptions="Center">
                    <ActivityIndicator 
                        IsRunning="{Binding IsBusy}"
                        HeightRequest="{Binding Source={x:Static Application.Current}, Path=MainPage.Height, Converter={StaticResource Fraction}, ConverterParameter=10}" />
                    <Label
                        Text="{Binding BusyProgressMessage}"
                        Margin="20,0"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        IsVisible="{Binding BusyProgressMessage, Converter={StaticResource NotNullOrEmptyStringToBoolean}}" />
                </StackLayout>
            </ContentView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>