<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.DatabaseStatusPage"
    ios:Page.UseSafeArea="True"
    Title="Actualización de Datos">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventLittleEmphasisStyleFontSize}" />
                <Setter Property="TextColor" Value="DimGray" />
            </Style>

            <sscxftoolkitpresentationconverters:FractionConverter x:Key="Fraction" />
            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="IfNullOrEmptyToString" StringReplacement="Actualización requerida" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="UpdatedToColorConverter" FalseString="IndianRed" TrueString="DimGray" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBoolean" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollView
                Grid.Row="0">
                <Grid 
                    Padding="20"
                    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label
                        Grid.Row="0" Grid.Column="0" 
                        FontFamily="Material Design Icons" 
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}"
                        Text="&#xf6af;"
                        TextColor="{StaticResource PrimaryBrandColor}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,4" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label
                        VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Última actualización" />
                    <Label 
                        x:Name="DatabaseStatusLabel" 
                        Grid.Row="1" Grid.ColumnSpan="4"
                        Text="{Binding Status, Converter={StaticResource IfNullOrEmptyToString}}"
                        TextColor="{Binding Updated, Converter={StaticResource UpdatedToColorConverter}}"
                        Margin="0,0,0,15" />
                    <Label 
                        Grid.Row="2" Grid.Column="0" 
                        FontFamily="Material Design Icons"  
                        Text="&#xf352;"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,4" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label 
                        Grid.Row="2" Grid.Column="1"
                        VerticalOptions="Center"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Cines" />
                    <Label 
                        Grid.Row="2" Grid.Column="2" 
                        FontFamily="Material Design Icons"  
                        Text="&#xf50d;"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,4" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label 
                        Grid.Row="2" Grid.Column="3"
                        VerticalOptions="Center"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Salas" />
                    <Label 
                        x:Name="DatabaseCinemaCountLabel" 
                        Grid.Row="3" Grid.ColumnSpan="2"
                        Text="{Binding CinemaCount}"
                        Margin="0,0,0,15" />
                    <Label 
                        x:Name="DatabaseRoomCountLabel" 
                        Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="2"
                        Text="{Binding RoomCount}"
                        Margin="0,0,0,15" />
                    <Label 
                        Grid.Row="4" Grid.Column="0" 
                        FontFamily="Material Design Icons"  
                        Text="&#xF381;"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,4" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label 
                        Grid.Row="4" Grid.Column="1"
                        VerticalOptions="Center"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Películas" />
                    <Label 
                        Grid.Row="4" Grid.Column="2" 
                        FontFamily="Material Design Icons" 
                        Text="&#xFA31;" 
                        TextColor="{StaticResource PrimaryBrandColor}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,4" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label 
                        Grid.Row="4" Grid.Column="3"
                        VerticalOptions="Center"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Eventos" />
                    <Label 
                        x:Name="DatabasePresentationCountLabel" 
                        Grid.Row="5" Grid.ColumnSpan="2"
                        Text="{Binding PresentationCount}"
                        Margin="0,0,0,15" />
                    <Label 
                        x:Name="DatabaseEventCountLabel" 
                        Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="2"
                        Text="{Binding EventCount}"
                        Margin="0,0,0,15" />
                    <Label 
                        Grid.Row="6" Grid.Column="0" 
                        FontFamily="Material Design Icons"  
                        Text="&#xf006;"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,4" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label 
                        Grid.Row="6" Grid.Column="1"
                        VerticalOptions="Center"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Personalidades" />
                    <Label 
                        Grid.Row="6" Grid.Column="2" 
                        FontFamily="Material Design Icons"  
                        Text="&#xf85f;"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,4" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label 
                        Grid.Row="6" Grid.Column="3"
                        VerticalOptions="Center"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Comentarios" />
                    <Label 
                        x:Name="DatabasePersonalityCountLabel" 
                        Grid.Row="7" Grid.ColumnSpan="2"
                        Text="{Binding PersonalityCount}"
                        Margin="0,0,0,15" />
                    <Label 
                        x:Name="DatabaseCommentCountLabel" 
                        Grid.Row="7" Grid.ColumnSpan="2" Grid.Column="2"
                        Text="{Binding CommentCount}"
                        Margin="0,0,0,15" />
                    <Label 
                        Grid.Row="8" Grid.Column="0" 
                        FontFamily="Material Design Icons"  
                        Text="&#xf2eb;"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}">
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="iOS" Value="0,0,0,3" />
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                    <Label 
                        Grid.Row="8" Grid.Column="1"
                        VerticalOptions="Center"
                        FontFamily="Helvetica LT Std Bold Condensed" 
                        TextColor="{StaticResource PrimaryBrandColor}" Text="Imágenes" />
                    <Label 
                        x:Name="DatabaseImageCountLabel" 
                        Grid.Row="9" Grid.ColumnSpan="2"
                        Text="{Binding ImageCount}" />
                </Grid>
            </ScrollView>
            <Grid 
                Margin="8"
                ColumnSpacing="8"
                Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Text="Actualizar"
                    Clicked="UpdateDatabaseButton_Clicked" />
                <Button
                    Grid.Column="1"
                    Text="Compartir"
                    Clicked="ShareDatabaseButton_Clicked" />
                <Button
                    Grid.Column="2"
                    Text="Eliminar"
                    Clicked="ClearDatabaseButton_Clicked" />
            </Grid>
            <ContentView
                Grid.RowSpan="2"
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#EEFFFFFF">
                <StackLayout VerticalOptions="Center">
                    <ActivityIndicator 
                        IsRunning="{Binding IsBusy}"
                        HeightRequest="{Binding Source={x:Static Application.Current}, Path=MainPage.Height, Converter={StaticResource Fraction}, ConverterParameter=10}" />
                    <Label
                        Text="{Binding BusyProgressMessage}"
                        Margin="20,0"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        IsVisible="{Binding BusyProgressMessage, Converter={StaticResource NotNullOrEmptyStringToBoolean}}" />
                </StackLayout>
            </ContentView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>