<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.SignOutPage"
    Title="Cerrar Sesión">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="Fraction" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBoolean" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <StackLayout Padding="20" Spacing="20">
                    <Label 
                        Margin="0,20"
                        HorizontalOptions="Center"
                        Text="&#xE05A;"
                        FontFamily="Iconmonstr Iconic"
                        FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}" />
                    <Label
                        Text="En esta sección podrá cerrar su sesión y con ella eliminar permanente de los datos especificados en su perfil, configuraciones realizadas a la aplicación, la actualización de la cartelera de cine y eventos, así como los comentarios y denuncias de comentarios no sincronizados."
                        HorizontalTextAlignment="Center" />
                    <Button
                        HorizontalOptions="Center"
                        Text="Cerrar Sesión"
                        Clicked="SignOutButton_Clicked"/>
                </StackLayout>
            </ScrollView>
            <ContentView
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#EEFFFFFF">
                <StackLayout VerticalOptions="Center">
                    <ActivityIndicator 
                        IsRunning="{Binding IsBusy}"
                        HeightRequest="{Binding Source={x:Static Application.Current}, Path=MainPage.Height, Converter={StaticResource Fraction}, ConverterParameter=10}" />
                    <Label
                        Text="{Binding BusyProgressMessage}"
                        Margin="20,0"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryBrandColor}"
                        IsVisible="{Binding BusyProgressMessage, Converter={StaticResource NotNullOrEmptyStringToBoolean}}" />
                </StackLayout>
            </ContentView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>