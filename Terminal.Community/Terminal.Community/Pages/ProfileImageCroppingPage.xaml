<?xml version="1.0" encoding="UTF-8"?>
<sscxftoolkitmvvmpages:ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.ProfileImageCroppingPage">
    <ContentPage.Title>
        <OnIdiom x:TypeArguments="x:String" Default="Recortar Imagen de Perfil" Phone="Recortar Imagen" />
    </ContentPage.Title>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Order="Primary"
            Activated="ApplyToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    Glyph="&#xf12c;"
                    FontFamily="Material Design Icons" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Order="Primary"
            Activated="CancelToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    Glyph="&#xf156;"
                    FontFamily="Material Design Icons" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
</sscxftoolkitmvvmpages:ContentPage>
