<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Converters"
    xmlns:ffilviewforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Views.Rendered"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.DatabaseShareSendPage"
    Title="Compartir con Amigos">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FlextLayoutToResponsiveItemWidthConverter x:Key="FlextLayoutToResponsiveItemWidth" ItemMinWidth="280" ItemHorizontalMargin="0" />
            <converters:WiFiHostpotDetailToQRImageSourceConverter x:Key="WiFiHostpotDetailToQRImageSourceConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="FactorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <StackLayout>
                <Button 
                    HorizontalOptions="End"
                    BackgroundColor="Transparent"
                    Padding="0"
                    WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize, Converter={StaticResource FactorConverter}, ConverterParameter=2}"
                    HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize, Converter={StaticResource FactorConverter}, ConverterParameter=2}"
                    Text="&#xf5ad;"
                    TextColor="Accent"
                    FontFamily="Material Design Icons"
                    FontSize="Large"
                    Clicked="CloseButton_Clicked" />
                <Label 
                    Grid.Row="0"
                    HorizontalTextAlignment="Center"
                    Text="Compartir Datos"
                    TextColor="Accent"
                    FontSize="Large" />
                <StackLayout>
                    <StackLayout 
                        IsVisible="{Binding IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                        HorizontalOptions="Center"
                        HeightRequest="320"
                        Padding="20">                    
                        <ffilviewforms:CachedImage 
                            Source="{Binding Path=WiFiHostpotDetail, Converter={StaticResource WiFiHostpotDetailToQRImageSourceConverter}, ConverterParameter=320}"
                            CacheType="None" />
                        <Label 
                            HorizontalTextAlignment="Center"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Para que tus amigos se conecten deberán escanear este código QR o conectarse a la red WiFi " />
                                    <Span Text="{Binding Path=WiFiHostpotDetail.SSID}" FontAttributes="Bold" TextColor="Accent" />
                                    <Span Text=" con seguridad WPA Personal y la contraseña " />
                                    <Span Text="{Binding Path=WiFiHostpotDetail.Password}" FontAttributes="Bold" TextColor="Accent" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>
                    <StackLayout>
                        <Label Text="Amigos" FontAttributes="Bold" />
                        <ScrollView
                            Margin="0,0,0,8">
                            <FlexLayout
                                x:Name="Wrapper"
                                Wrap="Wrap"
                                BindableLayout.ItemsSource="{Binding Path=Presences}">
                                <BindableLayout.EmptyView>
                                    <StackLayout>
                                        <ActivityIndicator
                                            HorizontalOptions="Center"
                                            IsRunning="True"
                                            Color="DimGray" />
                                        <Label
                                            HorizontalOptions="Center"
                                            Text="Esperando amigos ..."
                                            TextColor="DimGray" />
                                    </StackLayout>                                   
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout
                                            WidthRequest="{Binding Source={x:Reference Wrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                                            <ic:CircleImage
                                                HorizontalOptions="Center"
                                                BorderThickness="2"
                                                BorderColor="{StaticResource SecoundaryBrandColor}"
                                                WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityOverviewImageSize}"
                                                HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityOverviewImageSize}"/>
                                            <Label HorizontalTextAlignment="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <FormattedString.Spans>
                                                            <Span Text="{Binding Path=Friend.Name}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding Path=Friend.LastName}" />
                                                        </FormattedString.Spans>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </ScrollView>
                    </StackLayout>
                </StackLayout>
            </StackLayout>            
            <Grid 
                IsVisible="{Binding IsBusy}">
                <StackLayout VerticalOptions="Center">
                    <renderedviews:CircularProgressBar 
                        HorizontalOptions="Center"
                        WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}"
                        HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}"
                        Indeterminate="True" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="{Binding BusyProgressMessage}"
                        TextColor="Black"
                        FontSize="Medium" />
                    <Label
                        VerticalOptions="Start"
                        HorizontalTextAlignment="Center"
                        Text="{Binding BusyProgressMessageDetail}"
                        TextColor="DimGray"
                        FontSize="Default" />
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>