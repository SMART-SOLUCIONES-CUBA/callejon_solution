<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"    
    xmlns:ic="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:skiasharpformsviews="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Converters"
    xmlns:ffilviewforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.DatabaseShareSendPage"
    x:Name="Page"
    Title="Compartir con Amigos">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PageHeightToCuadrateSideSizeConverter x:Key="PageHeightToCuadrateSideSizeConverter" Page="{x:Reference Page}" />
            <converters:FlextLayoutToResponsiveItemWidthConverter x:Key="FlextLayoutToResponsiveItemWidth" ItemMinWidth="280" ItemHorizontalMargin="0" />
            <converters:WiFiHostpotDetailToQRImageSourceConverter x:Key="WiFiHostpotDetailToQRImageSourceConverter" />
            <converters:ProfileViewModelToImageSourceConverter x:Key="ProfileViewModelToImageSourceConverter" />
            <converters:FriendDataModelToImageSourceConverter x:Key="FriendDataModelToImageSourceConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="FactorConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter
                x:Key="ConnectivityStatusBoolToGlyphStringConverter"
                TrueString="&#xf003;"
                FalseString="&#xfbbd;" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter
                x:Key="ConnectivityStatusBoolToMessageStringConverter"
                TrueString="Su dispositivo esta en una red soportada. Puede alternativamente crear un punto de acceso WiFi."
                FalseString="Su dispositivo no esta conectado a una red. Debe unirse a una o crear un punto de acceso WiFi." />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label 
                    Grid.Column="1" Grid.Row="0"
                    Margin="20"
                    HorizontalTextAlignment="Center"
                    Text="Compartir Datos"
                    TextColor="Accent"
                    FontSize="Large" />
                <Button 
                    Grid.Column="2" Grid.Row="0"
                    HorizontalOptions="End" VerticalOptions="Start"
                    BackgroundColor="Transparent"
                    Margin="10" Padding="0"
                    WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize, Converter={StaticResource FactorConverter}, ConverterParameter=2}"
                    HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize, Converter={StaticResource FactorConverter}, ConverterParameter=2}"
                    Text="&#xf5ad;"
                    TextColor="{StaticResource PrimaryBrandColor}"
                    FontFamily="Material Design Icons"
                    FontSize="Large"
                    Clicked="CloseButton_Clicked" />
                <Grid Grid.ColumnSpan="3" Grid.Row="1">
                    <StackLayout 
                        IsVisible="{Binding Path=WiFiHostpotDetail, Converter={StaticResource NotNullToBooleanConverter}}"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        HeightRequest="280"
                        Padding="20">                    
                        <ffilviewforms:CachedImage 
                            Source="{Binding Path=WiFiHostpotDetail, Converter={StaticResource WiFiHostpotDetailToQRImageSourceConverter}, ConverterParameter=280}"
                            CacheType="None" />
                        <Label 
                            HorizontalTextAlignment="Center"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Para que tus amigos se conecten deberán escanear este código QR o conectarse a la red WiFi " />
                                    <Span Text="{Binding Path=WiFiHostpotDetail.SSID}" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrandColor}" />
                                    <Span Text=" con seguridad " />
                                    <Span Text="WPA Personal " FontAttributes="Bold" TextColor="{StaticResource PrimaryBrandColor}" />
                                    <Span Text=" y la contraseña " />
                                    <Span Text="{Binding Path=WiFiHostpotDetail.Password}" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrandColor}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>
                    <StackLayout
                        VerticalOptions="Center"
                        IsVisible="{Binding Path=WiFiHostpotDetail, Converter={StaticResource NullToBooleanConverter}}">
                        <Label
                            HorizontalOptions="Center"
                            Text="{Binding Path=IsBusy, Converter={StaticResource ConnectivityStatusBoolToGlyphStringConverter}}"
                            FontFamily="Material Design Icons"
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=ProfileOverviewImageSize}" />
                        <Label
                            Margin="20"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Path=IsBusy, Converter={StaticResource ConnectivityStatusBoolToMessageStringConverter}}"
                            TextColor="Black" />
                        <Button
                            HorizontalOptions="Center"
                            Text="Crear Punto de Acceso WiFi"
                            Clicked="CreateWiFiHostpotButton_Clicked" />
                    </StackLayout>
                </Grid>
            </Grid>
            <BoxView
                Grid.Row="1"
                HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=ProfileOverviewImageSize, Converter={StaticResource FractionConverter}, ConverterParameter=2}" />
            <BoxView
                Grid.Row="2"
                BackgroundColor="#EEEEEE"
                HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=ProfileOverviewImageSize, Converter={StaticResource FractionConverter}, ConverterParameter=2}" />
            <BoxView
                BackgroundColor="#EEEEEE"
                Grid.Row="3" />
            <skiasharpformsviews:SKCanvasView
                x:Name="CanvasView"
                Grid.Row="2" Grid.RowSpan="2"
                IsVisible="{Binding Path=IsBusy}"
                PaintSurface="SKCanvasView_PaintSurface"/>
            <BoxView
                Grid.Row="2"
                VerticalOptions="Start"
                BackgroundColor="LightGray"
                HeightRequest="1" />
            <Grid
                Grid.Row="1" Grid.RowSpan="2">
                <ic:CircleImage
                    HorizontalOptions="Center"
                    Source="{Binding Path=Profile, Converter={StaticResource ProfileViewModelToImageSourceConverter}, Mode=OneWay}"
                    BorderThickness="2"
                    BorderColor="{StaticResource SecoundaryBrandColor}"
                    HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=ProfileOverviewImageSize}"
                    WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=ProfileOverviewImageSize}" />
            </Grid>
            <Grid
                Grid.Row="3"
                HorizontalOptions="Center" VerticalOptions="Start"
                BindableLayout.ItemsSource="{Binding Path=Presences}"                    
                WidthRequest="{Binding Source={x:Reference Page}, Path=Height, Converter={StaticResource PageHeightToCuadrateSideSizeConverter}}"
                HeightRequest="{Binding Source={x:Reference Page}, Path=Height, Converter={StaticResource PageHeightToCuadrateSideSizeConverter}, ConverterParameter=0.6}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <BindableLayout.EmptyView>
                    <StackLayout
                        Grid.ColumnSpan="5" Grid.RowSpan="3"
                        IsVisible="{Binding IsBusy}"
                        VerticalOptions="Center">
                        <ActivityIndicator
                            HorizontalOptions="Center"
                            IsRunning="True"
                            Color="DimGray" />
                        <Label
                            HorizontalOptions="Center"
                            Text="Esperando amigos ..."
                            TextColor="DimGray" />
                    </StackLayout>                                   
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Grid.Column="{Binding Path=GridColumn}" Grid.Row="{Binding Path=GridRow}"
                            Margin="1"
                            RowSpacing="4">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="PresenceTapGestureRecognizer_Tapped" />
                            </Grid.GestureRecognizers>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ic:CircleImage
                                Grid.Row="0"
                                Source="{Binding Path=Friend, Converter={StaticResource FriendDataModelToImageSourceConverter}}"
                                HorizontalOptions="Center"
                                BorderThickness="2"
                                BorderColor="{StaticResource SecoundaryBrandColor}" />
                            <Label
                                Grid.Row="1"
                                Margin="3,0"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Path=Friend.Terminal.Name}"
                                FontSize="Micro" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>
            <Grid
                Grid.Row="3"
                Margin="20"
                VerticalOptions="End">
                <StackLayout>
                    <ProgressBar
                        IsVisible="{Binding Path=IsSendingBundle}"
                        ProgressColor="{StaticResource PrimaryBrandColor}"
                        Progress="{Binding Path=BundleSendProgress}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="{Binding Path=BusyProgressMessage}" />
                </StackLayout>
                <StackLayout IsVisible="{Binding Path=IsSendingBundle, Converter={StaticResource BoolToBoolNegationConverter}}">                    
                    <Button
                        HorizontalOptions="Center"
                        IsEnabled="{Binding Path=HasFirendReceivers}"
                        Text="Enviar"
                        Clicked="BroadcastDataBundleButton_Clicked" />
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>