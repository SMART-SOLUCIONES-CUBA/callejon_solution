<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Views.Rendered"
    xmlns:jmci="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Converters"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Helpers"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.CPCC.PCM.Terminal.Community.Pages.ProfileOverviewPage"
    Title="Perfil de Usuario">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="Margin" Value="5,10" />
            </Style>

            <converters:FlextLayoutToResponsiveItemWidthConverter x:Key="FlextLayoutToResponsiveItemWidth" ItemMinWidth="280" ItemHorizontalMargin="0" />
            <converters:ProfileViewModelToImageSourceConverter x:Key="ProfileViewModelToImageSource" />
            <converters:IfDefaultDateTimeToStringConverter x:Key="IfDefaultDateTimeToString" DefaultDateTimeString="-" />
            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="IfNullOrEmptyToString" StringReplacement="-" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="IsMaleToString" TrueString="Masculino" FalseString="Femenino" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Editar" Order="Primary" Activated="EditToolbarItem_Activated" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <ScrollView Orientation="Vertical">
            <StackLayout Spacing="0">
                <jmci:CircleImage
                    HorizontalOptions="Center"
                    Source="{Binding Converter={StaticResource ProfileViewModelToImageSource}, Mode=OneWay}"
                    BorderThickness="2"
                    BorderColor="{StaticResource SecoundaryBrandColor}"
                    Margin="0,50,0,20"
                    HeightRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}"
                    WidthRequest="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventPersonalityImageSize}" />
                <FlexLayout
                    x:Name="ResponsiveWrapper"
                    Margin="10"
                    Wrap="Wrap">
                    <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                        <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                            <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                            <Label
                                Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                Text="Nombre(s)" />
                        </StackLayout>
                        <Label 
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}" 
                            Text="{Binding FirstName}" />
                    </StackLayout>
                    <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                        <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                            <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                            <Label
                                Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                Text="Apellidos" />
                        </StackLayout>
                        <Label 
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}" 
                            Text="{Binding LastName}" />
                    </StackLayout>
                    <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                        <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                            <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                            <Label
                                Padding="0,4,0,0"
                                VerticalOptions="Fill"
                                VerticalTextAlignment="Center"
                                Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                Text="Sexo" />
                        </StackLayout>
                        <Label 
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}" 
                            Text="{Binding Path=IsMale, Converter={StaticResource IsMaleToString}}" />
                    </StackLayout>
                    <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                        <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                            <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                            <Label
                                Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                Text="Teléfono" />
                        </StackLayout>
                        <Label 
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}" 
                            Text="{Binding Path=Phone, Converter={StaticResource IfNullOrEmptyToString}}" />
                    </StackLayout>
                    <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                        <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                            <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                            <Label
                                Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                Text="Correo Electrónico" />
                        </StackLayout>
                        <Label 
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}" 
                            Text="{Binding Path=Email, Converter={StaticResource IfNullOrEmptyToString}}" />
                    </StackLayout>
                    <StackLayout WidthRequest="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}">
                        <StackLayout Orientation="Horizontal" Padding="0,10,0,0">
                            <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                            <Label
                                Style="{StaticResource BlockquoteHeaderLabelStyle}"
                                Text="Fecha de Nacimiento" />
                        </StackLayout>
                        <Label
                            FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}" 
                            Text="{Binding Path=BornDate, Converter={StaticResource IfDefaultDateTimeToString}}" />
                    </StackLayout>
                </FlexLayout>
                <StackLayout Orientation="Horizontal" Padding="10,0">
                    <BoxView Style="{StaticResource BlockquoteBoxViewStyle}" />
                    <Label
                        Style="{StaticResource BlockquoteHeaderLabelStyle}"
                        Text="Resumen" />
                </StackLayout>
                <Label
                    Margin="15,15"
                    FontSize="{Binding Source={x:Static helpers:SizeProvisioningHelper.Instance}, Path=EventMiddleEmphasisStyleFontSize}" 
                    Text="{Binding Path=About, Converter={StaticResource IfNullOrEmptyToString}}" />
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>