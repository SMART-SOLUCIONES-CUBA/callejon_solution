@model SmartSolucionesCuba.SAPRESSC.Core.Web.Security.Models.View.LoginViewModel

@using (Html.BeginForm("login", "account", new { Area = "security", ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="form-group">
        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Usuario" })
    </div>
    <div class="form-group">
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Contraseña" })
    </div>
    <div class="checkbox">
        <label>
            @Html.CheckBoxFor(m => m.RememberMe) Recordar estos datos para este dispositivo
        </label>
    </div>

    <div>
        <button type="submit" class="btn btn-block btn-primary">Entrar</button>
    </div>
}
