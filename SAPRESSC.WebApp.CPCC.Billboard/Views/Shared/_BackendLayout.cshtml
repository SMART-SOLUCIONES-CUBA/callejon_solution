@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View
@using Newtonsoft.Json;

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer ViewLocalizer
@inject SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Helpers.Localization.GlobalViewLocalizationHelper GlobalViewLocalizationHelper

@{ 
    var title = "Cartelera Administración";

    if (ViewData["Title"] != null) { title += " - " + ViewData["Title"]; }
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>@title</title>
        <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <!--[if  lt IE 9]>
            <link rel="stylesheet" href="~/lib/support/html5shiv.js" />
            <link rel="stylesheet" href="~/lib/support/respond.min.js" />
        <![endif]-->
        <style type="text/css">
            .navbar-right {
                margin: 0px;
            }

            .sidebar {
                position: fixed;
                top: 51px;
                bottom: 0;
                left: 0;
                z-index: 1000;
                display: block;
                padding: 20px;
                overflow-x: hidden;
                overflow-y: auto; /* Scrollable contents if viewport is shorter than content. */
                background-color: #f5f5f5;
                border-right: 1px solid #eee;
            }

            .nav-sidebar {
                margin-right: -21px;
                margin-bottom: 20px;
                margin-left: -20px;
            }

            .nav-sidebar > li > a {
                padding-right: 20px;
                padding-left: 20px;
            }

            .nav-sidebar > .active > a,
            .nav-sidebar > .active > a:hover,
            .nav-sidebar > .active > a:focus {
                color: #fff;
                background-color: #428bca;
            }

            .nav-sidebar .glyphicon {
                font-size: 14px !important;
                margin-right: 4px;
            }
        </style>
        @RenderSection("styles", false)
    </head>
    <body>
        <div class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand">@title</a>
                <p class="navbar-text visible-xs">@ViewData["Title"]</p>
            </div>
            <div class="collapse navbar-collapse">
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-2 sidebar hidden-sm hidden-xs">
                    @await Component.InvokeAsync("ManagementSidebarGroups")
                </div>
                <div class="col-md-10 col-md-offset-2" style="padding-top: 70px; padding-bottom: 15px;">
                    @if (ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] != null)
                    {
                        <ol class="breadcrumb">
                            @{
                                ICollection<BreadcrumbViewModel> breadcrumbs = ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] as ICollection<BreadcrumbViewModel>;

                                if (breadcrumbs != null)
                                {
                                    var total = breadcrumbs.Count();
                                    var count = 1;

                                    foreach (var breadcrumb in breadcrumbs)
                                    {
                                        if (count < total)
                                        {
                                            <li><a href="@breadcrumb.Url">@Html.Raw(breadcrumb.Caption)</a></li>
                                        }
                                        else
                                        {
                                            <li class="active">@Html.Raw(breadcrumb.Caption)</li>
                                        }

                                        count++;
                                    }
                                }
                            }
                        </ol>
                    }

                    @if (TempData[NotificationViewModel.NOTIFICATION_MAP_KEY] != null)
                    {
                        var notification = JsonConvert.DeserializeObject<NotificationViewModel>(TempData[NotificationViewModel.NOTIFICATION_MAP_KEY].ToString());

                        <div class="alert alert-@Html.Raw(notification.Type.ToString().ToLower())">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            @if (notification.Title != null)
                            {
                                <h4>@GlobalViewLocalizationHelper.Localize(notification.Title, ViewLocalizer)</h4>
                            }

                            @if (notification.Message != null)
                            {
                                @Html.Raw(GlobalViewLocalizationHelper.Localize(notification.Message, ViewLocalizer));
                            }

                            @if (notification.Messages != null)
                            {
                                <ul>
                                    @foreach (var item in notification.Messages)
                                    {
                                        <li>@GlobalViewLocalizationHelper.Localize(item, ViewLocalizer)</li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {
                $(document).on("click", "button.filter-form-reseter", function(e) {
                    $(e.target.form).find("select option").prop("selected", false);

                    $(e.target.form).find("input[type=text]").prop("value", '');

                    e.target.form.submit();
                });
            });
        </script>
        @RenderSection("scripts", false)
    </body>
</html>
