@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer ViewLocalizer
@inject SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Helpers.Localization.GlobalViewLocalizationHelper GlobalViewLocalizationHelper

@model SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Models.View.DashboardViewModel

@{
    ViewData["Title"] = "Vistazo";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"glyphicon glyphicon-home\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";

    var securityCount = 
        Model.PersistenceSecurityUserCount +
        Model.PersistenceSecurityGroupCount +
        Model.PersistenceSecurityRoleCount +
        Model.PersistenceSecurityTraceCount;

    var commentCount = 
        Model.PersistenceBillboardProductionCommentCount + 
        Model.PersistenceBillboardEventCommentCount + 
        Model.PersistenceBillboardPersonalityCommentCount;

    var billboardCount =
        Model.PersistenceBillboardConfigCount +
        Model.PersistenceBillboardEventCount +
        Model.PersistenceBillboardHighlightCount +
        Model.PersistenceBillboardPresentationCount +
        Model.PersistenceBillboardProductionCount;

    var supportCount =
        Model.PersistenceSupportAwardCount +
        Model.PersistenceSupportCategoryCount +
        Model.PersistenceSupportCinemaCount +
        Model.PersistenceSupportClasifiersCount +
        Model.PersistenceSupportCountryCount +
        Model.PersistenceSupportGenreCount +
        Model.PersistenceSupportLanguageCount +
        Model.PersistenceSupportPersonalityCount +
        Model.PersistenceSupportProductionHouseCount;

    var entityCount =
        securityCount +
        billboardCount +
        supportCount +
        commentCount;
}

@section styles {
    <link rel="stylesheet" type="text/css" href="~/lib/iconmonstr/css/iconmonstr-iconic-font.min.css" />
    <style type="text/css">
        .panel .glyphicon {
            font-size: 28px;
        }
    </style>
}

