<div class="row">
    <div class="col-sm-6">
    @for (int i = 0; i < Model.Groups.Count; i += 2)
    {
        var group = Model.Groups.ElementAt(i);

        <div class="panel panel-default">
            <div class="panel-heading">@group.Key</div>
            <div class="panel-body">
                @{
                    var total = group.Value.Count;
                    var count = 0;
                }
                @while (count < total)
                {
                    var subList = group.Value.Skip(count).Take(3);

                    <div class="row">
                    @foreach (var item in subList)
                    {
                        <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                            @if (User.HasClaim(claim => claim.Type.Equals(SmartSolucionesCuba.SAPRESSC.Core.Web.Security.ClaimTypes.AccountWithFullAccess) && claim.Value.Equals(true.ToString())) || User.IsInRole(item.Role))
                            {
                                <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                    @Html.Raw(SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Helpers.DashboardManagementItemIconographyHelper.GetIconography(item))
                                    <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">
                                    @Html.Raw(SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Helpers.DashboardManagementItemIconographyHelper.GetIconography(item))
                                    <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                </div>
                            }
                        </div>
                    }
                    </div>
                    {
                        count += 3;
                    }
                }
            </div>
        </div>
    }
    </div>
    <div class="col-sm-6">
    @if (Model.Groups.Count > 1)
    {
        for (int i = 1; i < Model.Groups.Count; i += 2)
        {
            var group = Model.Groups.ElementAt(i);

            <div class="panel panel-default">
                <div class="panel-heading">@group.Key</div>
                <div class="panel-body">
                    @{
                        var total = group.Value.Count;
                        var count = 0;
                    }
                    @while (count < total)
                    {
                        var subList = group.Value.Skip(count).Take(3);

                        <div class="row">
                            @foreach (var item in subList)
                            {
                                <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                    @if (User.HasClaim(claim => claim.Type.Equals(SmartSolucionesCuba.SAPRESSC.Core.Web.Security.ClaimTypes.AccountWithFullAccess) && claim.Value.Equals(true.ToString())) || User.IsInRole(item.Role))
                                    {
                                        <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                            @Html.Raw(SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Helpers.DashboardManagementItemIconographyHelper.GetIconography(item))
                                            <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            @Html.Raw(SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Helpers.DashboardManagementItemIconographyHelper.GetIconography(item))
                                            <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        {
                            count += 3;
                        }
                    }
                </div>
            </div>
        }
    }
    </div>
</div>