<div class="row">
    <div class="col-sm-6 col-md-4">
        <div class="alert alert-success">
            <table>
                <tr>
                    <td valign="middle"><span class="im im-database" style="font-size: 32px; margin-top: 3px;"></span></td>
                    <td valign="middle" style="padding-left: 15px; padding-right: 15px; width: 100%;">
                        <div style="font-weight: bold;">Actual Base de Datos Móvil</div>
                        @if (string.IsNullOrEmpty(Model.CurrentPortableDatabaseDateTimeFormated))
                        {
                            <div><i>no se ha generado aún</i></div>
                        }
                        else
                        {
                            <div>@Model.CurrentPortableDatabaseDateTimeFormated</div>
                        }
                    </td>
                    <td valign="middle">
                        <a class="btn btn-success" href="@Url.Action("build", "database")" title="Genera manualmente la actualización de la base de datos para las aplicaciones móviles. El proceso puede demorar entre 3 y 5 minutos. La actualización estará disponible automáticamente cuando termine el proceso.">
                            <span class="glyphicon glyphicon-refresh"></span>
                        </a>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="alert alert-warning">
            <table>
                <tr>
                    <td valign="middle"><span class="glyphicon glyphicon-hdd" style="font-size: 32px; margin-top: 3px;"></span></td>
                    <td valign="middle" style="padding-left: 15px; padding-right: 15px; width: 100%;">
                        <div style="font-weight: bold;">Empaquetar Actualización</div>
                        <div>Actualización portable</div>
                    </td>
                    <td valign="middle">
                        <a class="btn btn-warning" href="@Url.Action("pack", "database")">
                            <span class="glyphicon glyphicon-download-alt"></span>
                        </a>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="alert alert-info">
            <table>
                <tr>
                    <td valign="middle"><span class="im im-flip-chart-o" style="font-size: 32px; margin-top: 3px;"></span></td>
                    <td valign="middle" style="padding-left: 15px; padding-right: 15px; width: 100%;">
                        <div style="font-weight: bold;">Programación (próximos 7 días)</div>
                        <div>Eventos: <span style="color: #444;">@Model.NextWeekBillboardEventCount</span>, Audio Visuales: <span style="color: #444;">@Model.NextWeekBillboardPresentationCount</span></div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

