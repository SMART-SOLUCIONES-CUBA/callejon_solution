@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.Filter.ProducerHouseFilterModel

@using (Html.BeginForm("filter", "producerhouses", new { Area = "cinemabillboard" }, FormMethod.Post, true, null))
{
    <fieldset>
        <legend>Filtro de Casas Productoras</legend>
        <div style="margin-bottom: 20px;">
            @Html.LabelFor(model => model.Name, "Nombre", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
        </div>

        <div>
            <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-filter"></span> Filtrar</button>
            <button type="button" class="btn btn-default filter-form-reseter"><span class="glyphicon glyphicon-remove-circle"></span> Limpiar</button>
        </div>
    </fieldset>
}

