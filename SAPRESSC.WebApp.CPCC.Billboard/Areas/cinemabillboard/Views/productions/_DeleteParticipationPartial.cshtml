@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.ParticipationDisplayViewModel

<div class="modal fade" id="delete-participation-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="delete-participation-@Model.Id-lable" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("deleteparticipation", "productions", null, FormMethod.Post, true, new { @class = "modal-content" }))
            {
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.ProductionId)

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="delete-participation-@Model.Id-lable">Eliminar Participación</h4>
                </div>
                <div class="modal-body">
                    <p>Esta seguro que desea eliminar la participación detallada a continuación?</p>

                    <dl>
                        <dt>Personalidad</dt>
                        <dd>@Model.Personality.Name @Model.Personality.LastName</dd>
                        <dt>Rol</dt>
                        <dd>@Model.ProductionRole</dd>
                        <dt>Especificación</dt>
                        <dd>@Model.Specification</dd>
                    </dl>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
