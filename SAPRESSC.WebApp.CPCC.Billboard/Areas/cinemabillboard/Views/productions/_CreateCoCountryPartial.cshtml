@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.CoCountryInputViewModel

<div class="modal fade" id="add-cocountry" tabindex="-1" role="dialog" aria-labelledby="add-cocountry-lable" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("addcocountry", "productions", null, FormMethod.Post, true, new { @class = "modal-content" }))
            {
                @Html.HiddenFor(model => model.ProductionId)

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="add-cocountry-lable">Agregar País Co-Productor</h4>
                </div>
                <div class="modal-body">
                    <div>
                        @Html.LabelFor(model => model.CountryId, new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.CountryId, Model.Countries, new { @class = "form-control" })
                    </div>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-primary">Agregar</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
