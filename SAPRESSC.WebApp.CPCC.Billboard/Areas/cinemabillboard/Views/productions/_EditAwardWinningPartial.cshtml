@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.AwardWinningInputViewModel

<div class="modal fade" id="edit-awardwinning-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="edit-awardwinning-@Model.Id-lable" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("editawardwinning", "productions", null, FormMethod.Post, true, new { @class = "modal-content" }))
            {
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.ProductionId)

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="edit-awardwinning-@Model.Id-lable">Modificar Condecoración</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.AwardId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.AwardId, Model.Awards, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.Edition, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.Edition, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.WinType, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.WinType, Model.WinTypes, new { @class = "form-control" })
                        </div>
                    </div>
                    <div style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.Category, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Category, new { @class = "form-control" })
                    </div>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-primary">Modificar</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
