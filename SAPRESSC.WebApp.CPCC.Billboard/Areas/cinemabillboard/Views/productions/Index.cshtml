@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;

@model PaginationViewModel<SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.ProductionDisplayViewModel>

@{
    ViewData["Title"] = "Gestión de Películas";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
{
new BreadcrumbViewModel
{
    Caption = "<span class=\"glyphicon glyphicon-home\"></span> Inicio",
    Url = "/"
},
new BreadcrumbViewModel
{
    Caption = "Administración",
    Url = Url.Action("index", "management", new { Area = string.Empty })
},
new BreadcrumbViewModel
{
    Caption = "Películas"
}
};

    Layout = "_BackendLayout";
}

<div class="row" style="margin-bottom: 20px;">
    <div class="col-sm-8">
        @await Html.PartialAsync("_ProductionsFilterPartial", Model.Filter)
    </div>
    <div class="col-sm-4"><a class="btn btn-primary pull-right" href="@Url.Action("create")"><span class="glyphicon glyphicon-plus-sign"></span> Agregar</a></div>
</div>

@if (Model.MaxPageCount > 0)
{
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = paginationStart - 1 + Model.List.Count;

        <div class="text-center">
            <ul class="pagination" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&raquo;</a></li>
                }
            </ul>
            <div class="text-info" style="margin-top: 10px; margin-bottom: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
        </div>
    }

    <div style="border: 1px solid #DDD; border-radius: 4px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Año</th>
                    <th>País</th>
                    <th style="width: 232px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td style="vertical-align: middle;" title="Título">@item.Title @if (item.LocalizedTitle != null)
                        {<span>(@item.LocalizedTitle)</span>}</td>
                        <td style="vertical-align: middle;" title="Año">@item.Year</td>
                        <td style="vertical-align: middle;" title="País">@item.Country.Name</td>
                        <td style="vertical-align: middle;">
                            <div class="btn-group btn-group-sm">
                                <a role="button" href="#" class="btn btn-default" data-toggle="modal" data-target="#detail-view-production-@item.Id"><span class="glyphicon glyphicon-list-alt"></span></a>
                                <button type="button" class="btn btn-default" data-toggle="dropdown">
                                    <span class="glyphicon glyphicon-edit"></span> Modificar <span class="caret" style="margin-left: 2px;"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a href="@Url.Action("edit", new { key = item.Id })" title="Modificar Información">Información</a></li>
                                    <li><a href="@Url.Action("participations", new { key = item.Id })" title="Modificar Participaciones">Participaciones</a></li>
                                    <li><a href="@Url.Action("awardwinnings", new { key = item.Id })" title="Modificar Galardones">Condecoraciones</a></li>
                                    <li><a href="@Url.Action("cocountries", new { key = item.Id })" title="Modificar Galardones">Países Co-Productores</a></li>
                                </ul>
                                <a role="button" href="@Url.Action("delete", new {key = item.Id})" class="btn btn-danger"><span class="glyphicon glyphicon-trash"></span> Eliminar</a>
                            </div>

                            <div class="modal fade" id="detail-view-production-@item.Id" tabindex="-1" role="dialog" aria-labelledby="detail-view-production-@item.Id-lable" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                            <h4 class="modal-title" id="detail-view-production-@item.Id-lable">Detalles de la Película</h4>
                                        </div>
                                        <div class="modal-body">
                                            @await Html.PartialAsync("_DetailProductionPartial", item)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = paginationStart - 1 + Model.List.Count;

        <div class="text-center" style="margin-top: 20px;">
            <ul class="pagination" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&raquo;</a></li>
                }
            </ul>
            <div class="text-info" style="margin-top: 10px; margin-bottom: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
        </div>
    }
}
else
{
    <div style="border: 1px solid #DDD; border-radius: 4px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Año</th>
                    <th>País</th>
                    <th style="width: 232px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="4"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                </tr>
            </tbody>
        </table>
    </div>
}
