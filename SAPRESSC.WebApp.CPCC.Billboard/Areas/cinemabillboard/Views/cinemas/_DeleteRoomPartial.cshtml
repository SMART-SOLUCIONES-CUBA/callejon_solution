@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.RoomInputViewModel

<div class="modal fade" id="delete-room-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="delete-room-@Model.Id-lable" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("deleteroom", "cinemas", null, FormMethod.Post, true, new { @class = "modal-content" }))
            {
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.CinemaId)

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="delete-room-@Model.Id-lable">Eliminar Sala</h4>
                </div>
                <div class="modal-body">
                    <p>Esta seguro que desea eliminar la sala detallada a continuación?</p>

                    <dl>
                        <dt>Nombre</dt>
                        <dd>@Html.DisplayFor(model => model.Name)</dd>
                    </dl>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
