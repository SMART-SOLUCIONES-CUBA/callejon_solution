@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.ProductionDisplayViewModel

@{ 
    var duration = string.Format("{0} hora {1} minutos", Model.Duration.Hours, Model.Duration.Minutes);

    if (Model.Duration.Hours < 1)
    {
        duration = string.Format("{0} minutos", Model.Duration.Minutes);
    }
    else if (Model.Duration.Hours > 1)
    {
        duration = string.Format("{0} horas {1} minutos", Model.Duration.Hours, Model.Duration.Minutes);
    }
}

<div class="row">
    <div class="col-md-6" style="text-align: center; margin-bottom: 20px;">
        <img class="img-thumbnail" src="@Url.Action("image", "default", new { Area = "media", key = Model.PosterImageId })" />
    </div>
    <div class="col-md-6">
        <dl style="margin-bottom: 0;">
            <dt>Título</dt>
            <dd>@Html.DisplayFor(model => model.Title)</dd>
            @if (Model.LocalizedTitle != null)
            {
                <dt>Título en Español</dt>
                <dd>@Html.DisplayFor(model => model.LocalizedTitle)</dd>
            }
            <dt>Discriminador</dt>
            <dd>@Model.Slug</dd>
            <dt>Categoría</dt>
            <dd>@Model.Category.Name</dd>
            <dt>Valoración</dt>
            <dd>
                @for (int i = 1; i <= 5; i++)
                {
                    if (Model.Rate >= i)
                    {
                        <span class="glyphicon glyphicon-star"></span>
                    }
                    else
                    {
                        <span class="glyphicon glyphicon-star-empty"></span>
                    }
                }
            </dd>
            <dt>País</dt>
            <dd>@Model.Country.Name</dd>
            <dt>Idioma</dt>
            <dd>@Model.Language.Name</dd>
            <dt>Año</dt>
            <dd>@Html.DisplayFor(model => model.Year)</dd>
            <dt>Duración</dt>
            <dd>@duration</dd>
            <dt>Sinopsis</dt>
            <dd>@Html.DisplayFor(model => model.About)</dd>
        </dl>
    </div>
    <div class="col-md-12">
        <dl style="margin-bottom: 0;">
            <dt>Géneros</dt>
            <dd>
                @if (Model.Genres.Count() > 0)
                {
                    @string.Join(", ", Model.Genres.Select(item => item.Name).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Casas Productoras</dt>
            <dd>
                @if (Model.ProducerHouses.Count() > 0)
                {
                    @string.Join(", ", Model.ProducerHouses.Select(item => item.Name).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Condecoraciones</dt>
            <dd>
                @if (Model.AwardWinnings.Count() > 0)
                {
                    @string.Join(", ", Model.AwardWinnings.Select(item => string.Join(" ", new string[]
                    {
                        item.Type.ToString(),
                        item.Award.Name,
                        item.Edition,
                        item.Category
                    })).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Producción</dt>
            <dd>
                @if (Model.Productors.Count() > 0)
                {
                    @string.Join(", ", Model.Productors.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Dirección</dt>
            <dd>
                @if (Model.Directors.Count() > 0)
                {
                    @string.Join(", ", Model.Directors.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Interpretación</dt>
            <dd>
                @if (Model.Interpreters.Count() > 0)
                {
                    @string.Join(", ", Model.Interpreters.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Guión</dt>
            <dd>
                @if (Model.Screenplayers.Count() > 0)
                {
                    @string.Join(", ", Model.Screenplayers.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Fotografía</dt>
            <dd>
                @if (Model.Photographers.Count() > 0)
                {
                    @string.Join(", ", Model.Photographers.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Sonido</dt>
            <dd>
                @if (Model.Sounders.Count() > 0)
                {
                    @string.Join(", ", Model.Sounders.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Edición</dt>
            <dd>
                @if (Model.Editors.Count() > 0)
                {
                    @string.Join(", ", Model.Editors.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
            <dt>Dirección Artística</dt>
            <dd>
                @if (Model.ArtisticManagers.Count() > 0)
                {
                    @string.Join(", ", Model.ArtisticManagers.Select(item => item.Name + " " + item.LastName).ToArray())
                }
                else
                {
                    <span>Sin elementos que mostrar</span>
                }
            </dd>
        </dl>
    </div>
</div>