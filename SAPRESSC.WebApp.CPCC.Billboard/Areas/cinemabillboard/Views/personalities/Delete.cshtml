@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;

@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.PersonalityDisplayViewModel

@{
    ViewData["Title"] = "Eliminar Personalidad";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"glyphicon glyphicon-home\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración",
            Url = Url.Action("index", "management", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Personalidades",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = "Eliminar"
        }
    };

    Layout = "_BackendLayout";
}

<h3>Esta seguro que desea eliminar la personalidad detallada a continuación y con ella sus participaciones en Películas e invitaciones a Eventos?</h3>

<br />

<div class="row">
    <div class="col-lg-2 col-md-3">
        @if (Model.ImageId != System.Guid.Empty)
        {
            <img class="img-circle" src="@Url.Action("image", "default", new { Area = "media", key = Model.ImageId })" />
        }
        else
        {
            <img class="img-circle" src="/img/default-person-picture.jpg" />
        }
    </div>
    <div class="col-lg-10 col-md-9">
        <dl>
            <dt>Nombre(s)</dt>
            <dd>@Html.DisplayFor(model => model.Name)</dd>
            <dt>Apellido(s)</dt>
            <dd>@Html.DisplayFor(model => model.LastName)</dd>
            <dt>Fecha de Nacimiento</dt>
            <dd>@Model.BornDate.ToShortDateString()</dd>
            <dt>Sexo</dt>
            <dd>
            @if (Model.Sex == SmartSolucionesCuba.SAPRESSC.Middleware.Identity.Persistence.Enumerations.Sex.Male)
            { <span>Masculino</span> }
            else
            { <span>Femenino</span> }
            </dd>
            @await Component.InvokeAsync("PersonalityRelationshipsDetail", Model.Id)
            <dt>Acerca de</dt>
            <dd>@Html.DisplayFor(model => model.About)</dd>
        </dl>
    </div>
</div>
@using (Html.BeginForm("delete", "personalities", new { Area = "cinemabillboard", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-default" href="@Url.Action("index")">Cancelar</a>
    </div>
}
