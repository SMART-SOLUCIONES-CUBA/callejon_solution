@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.CPCC.Web.BackEnd.Models.View.EventCommentDelationDisplayViewModel

@{ 
    var compoundId = Model.CommentId + "-" + Model.Id;
}

<div class="modal fade" id="delete-delation-@compoundId" tabindex="-1" role="dialog" aria-labelledby="delete-delation-@compoundId-lable" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("deletedelation", "eventcomments", null, FormMethod.Post, true, new { @class = "modal-content" }))
            {
                @Html.HiddenFor(model => model.CommentId)
                @Html.HiddenFor(model => model.Id)

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="delete-delation-@compoundId-lable">Eliminar Denuncia de Comentario</h4>
                </div>
                <div class="modal-body">
                    <p>Está seguro que desea eliminar la denuncia de comentario detallada a continuación?</p>

                    <div class="row" style="margin-top: 30px;">
                        <div class="col-sm-3" style="margin-bottom: 20px;">
                            @if (Model.Client.ImageId != System.Guid.Empty)
                            {
                                <img class="img-circle img-responsive" src="@Url.Action("image", "default", new { Area = "media", key = Model.Client.ImageId })" />
                            }
                            else
                            {
                                <img class="img-circle img-responsive" src="/img/default-person-picture.jpg" />
                            }
                        </div>
                        <div class="col-sm-9" style="margin-bottom: 20px;">
                            <h4>@Model.Client.FullName</h4>
                            <p class="text-muted">@Model.Created</p>
                            <p>@Model.Note</p>
                        </div>
                    </div>

                    <div class="clearfix"></div>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
