@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View
@using Newtonsoft.Json;

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer ViewLocalizer
@inject SmartSolucionesCuba.SAPRESSC.WebApp.CPCC.Billboard.Helpers.Localization.GlobalViewLocalizationHelper GlobalViewLocalizationHelper

@{
    var title = "Cartelera";

    if (ViewData["Title"] != null) { title += " - " + ViewData["Title"]; }
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>@title</title>
        <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <!--[if  lt IE 9]>
            <link rel="stylesheet" href="~/lib/support/html5shiv.js" />
            <link rel="stylesheet" href="~/lib/support/respond.min.js" />
        <![endif]-->
        <style type="text/css">
            .navbar-right {
                margin: 0px;
            }
        </style>
        @RenderSection("styles", false)
    </head>
    <body>
        <div class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand">@title</a>
                <p class="navbar-text visible-xs">@ViewData["Title"]</p>
            </div>
            <div class="collapse navbar-collapse">
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>
        <div class="container-fluid" style="padding-top: 70px;">
            @if (ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] != null)
            {
                <ol class="breadcrumb">
                    @{
                        ICollection<BreadcrumbViewModel> breadcrumbs = ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] as ICollection<BreadcrumbViewModel>;

                        if (breadcrumbs != null)
                        {
                            var total = breadcrumbs.Count();
                            var count = 1;

                            foreach (var breadcrumb in breadcrumbs)
                            {
                                if (count < total)
                                {
                                    <li><a href="@breadcrumb.Url">@Html.Raw(breadcrumb.Caption)</a></li>
                                }
                                else
                                {
                                    <li class="active">@Html.Raw(breadcrumb.Caption)</li>
                                }

                                count++;
                            }
                        }
                    }
                </ol>
            }

            @if (TempData[NotificationViewModel.NOTIFICATION_MAP_KEY] != null)
            {
                var notification = JsonConvert.DeserializeObject<NotificationViewModel>(TempData[NotificationViewModel.NOTIFICATION_MAP_KEY].ToString());

                <div class="alert alert-@Html.Raw(notification.Type.ToString().ToLower())">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                    @if (notification.Title != null)
                    {
                        <h4>@GlobalViewLocalizationHelper.Localize(notification.Title, ViewLocalizer)</h4>
                    }

                    @if (notification.Message != null)
                    {
                        @Html.Raw(GlobalViewLocalizationHelper.Localize(notification.Message, ViewLocalizer));
                    }

                    @if (notification.Messages != null)
                    {
                        <ul>
                            @foreach (var item in notification.Messages)
                            {
                                <li>@GlobalViewLocalizationHelper.Localize(item, ViewLocalizer)</li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (ViewData["Heading"] != null)
            {
                <div class="page-header" style="margin-top: 0;">
                    <h1 style="margin-top: 0;">
                        @ViewData["Heading"]
                        @if (ViewData["SubHeading"] != null)
                        { <small>@ViewData["SubHeading"]</small>}
                    </h1>
                </div>
            }

            @RenderBody()
        </div>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
        @RenderSection("scripts", false)
    </body>
</html>
