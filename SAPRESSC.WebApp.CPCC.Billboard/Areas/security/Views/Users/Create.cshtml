@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;

@model SmartSolucionesCuba.SAPRESSC.Core.Web.SecurityLocal.Models.View.UserWithPasswordInputViewModel

@{
    ViewData["Title"] = "Agregar Usuario";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"glyphicon glyphicon-home\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración",
            Url = Url.Action("index", "management", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Usuarios",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = "Agregar"
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("create", "users", new { Area = "security" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="panel panel-default">
        <div class="panel-heading"><h4>@ViewData["Title"]</h4></div>

        <div class="panel-body">
            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Id, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Id, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Id, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Password, new { @class = "control-label" })
                    @Html.PasswordFor(model => model.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Password, null, new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.ConfirmPassword, new { @class = "control-label" })
                    @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-sm-4 style="margin-bottom: 20px;"">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) Habilitado
                            @Html.ValidationMessageFor(model => model.Enabled)
                        </label>
                    </div>
                </div>

                <div class="col-sm-4" style="margin-bottom: 20px;">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.PasswordChangeRequired) Debe cambiar la contraseña?
                            @Html.ValidationMessageFor(model => model.PasswordChangeRequired)
                        </label>
                    </div>
                </div>

                <div class="col-sm-4" style="margin-bottom: 20px;">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.HasFullAccess) Es super usuario?
                            @Html.ValidationMessageFor(model => model.HasFullAccess)
                        </label>
                    </div>
                </div>
            </div>

            <fieldset style="margin-bottom: 20px;">
                <legend>@Html.LabelFor(model => model.SelectableGroups)</legend>
                <div class="row">
                @if (Model.SelectableGroups != null && Model.SelectableGroups.Count() > 0)
                {
                    for (int i = 0; i < Model.SelectableGroups.Count(); i++)
                    {
                        @Html.EditorFor(subModel => subModel.SelectableGroups[i], "SelectionDescriptedGuidIDItemInputViewModel");
                    }
                }
                else
                {
                    <div class="editor-field col-md-12">Sin elementos que mostrar.</div>
                }
                </div>
            </fieldset>
            <div>
                <button type="submit" class="btn btn-primary">Crear</button>
                <a class="btn btn-default" href="@Url.Action("index")">Cancelar</a>
            </div>
        </div>
    </div>
}