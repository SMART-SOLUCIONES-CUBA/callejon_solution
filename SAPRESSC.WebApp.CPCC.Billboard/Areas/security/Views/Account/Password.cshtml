@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View

@model SmartSolucionesCuba.SAPRESSC.Core.Web.Security.Models.View.ChangePasswordViewModel

@{
    ViewData["Heading"] = "Cambiar contraseña";

    ViewData["Title"] = ViewData["Heading"];

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"glyphicon glyphicon-home\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Mi Cuenta",
            Url = Url.Action("index", "account", new { Area = "security" })
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Heading"].ToString()
        }
    };

    Layout = "/Areas/Security/Views/Shared/_BaseAccountLayout.cshtml";
}


@using (Html.BeginForm("password", "account", new { Area = "security" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="row">
        <div class="col-lg-6 col-md-8 col-sm-7">

            <div class="form-group">
                @Html.LabelFor(m => m.OldPassword, new { @class = "control-label" })
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.OldPassword, null, new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.NewPassword, new { @class = "control-label" })
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NewPassword)
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <hr />

    <div>
        <button type="submit" class="btn btn-primary">Cambiar</button>
        <a class="btn btn-default" href="@Url.Action("index")">Cancelar</a>
    </div>
}
