@model SmartSolucionesCuba.SAPRESSC.Business.Billboard.Cinema.Web.Manager.Models.View.SubscriptionChangePasswordViewModel

<div class="modal fade" id="change-password-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="change-password-@Model.Id-lable" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        @using (Html.BeginForm("changepassword", "subscriptions", new { Area = "mediastore" }, FormMethod.Post, true, new { id = "changePasswordForm" + Model.UserId, @class = "modal-content" }))
        {
            @Html.HiddenFor(model => model.Id)

            <div class="modal-header">
                <h5 class="modal-title" id="change-password-@Model.UserId-lable">Cambiar Contraseña</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.Id, new { @class = "control-label" })
                        <div>@Model.Id</div>
                    </div>
                    <div class="col-sm-6" style="margin-bottom: 20px;">            
                        <div class="checkbox">
                            <label>
                                @Html.EditorFor(model => model.ChangePasswordRequired) Debe cambiar la contraseña?
                            </label>
                        </div>
                    </div> 
                </div>            
                <div class="row">
                    <div class="col-sm-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.NewPassword, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.NewPassword, new { @class = "form-control" })                  
                    </div>
                    <div class="col-sm-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.ConfirmPassword, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.ConfirmPassword, new { @class = "form-control" })                 
                    </div>
                </div>
            </div>
            <div class="modal-footer"style="margin-top: 0;">
                <button type="submit" class="btn btn-primary">Cambiar</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>                
            </div>
        }
    </div>
</div>